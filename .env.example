# Copy to .env or pass --env-file to scripts/onprem/start-onprem.sh.
# Do not put real API keys in committed files.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# start_native_backend.py inherits process environment; its child loads root .env
# without overriding it. A separate EnvFile is supported by start-onprem.sh only.

# Optional overrides if the backend or frontend entry point changes.
# ONPREM_BACKEND_COMMAND=python3 -m backend.onprem.api.server
# ONPREM_FRONTEND_COMMAND=npm run build && exec npm run start

# Host/port are normally supplied through start-onprem.sh parameters.
# The launcher passes them to the backend as CITYVERSE_HOST/CITYVERSE_PORT.

# QoS mode preserves scenario load; reject requests above this per-direction generator ceiling.
# This is an operator limit, not verified network capacity (valid range: 1..400000 kbps).
CITYVERSE_ONPREM_QOS_MAX_OFFERED_KBPS=10000
