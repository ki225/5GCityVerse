diff --git a/gnb/ran_ue_identity_test.go b/gnb/ran_ue_identity_test.go
new file mode 100644
--- /dev/null
+++ b/gnb/ran_ue_identity_test.go
@@ -0,0 +1,31 @@
+package gnb
+
+import "testing"
+
+func TestRanUeIdIsNotImmediatelyReused(t *testing.T) {
+	generator := NewRanUeNgapIdGenerator()
+	first := generator.AllocateRanUeId()
+	if first != 1 {
+		t.Fatalf("first ID = %d, want 1", first)
+	}
+	generator.ReleaseRanUeId(first)
+	if next := generator.AllocateRanUeId(); next != 2 {
+		t.Fatalf("released ID was reused: got %d, want 2", next)
+	}
+}
+
+func TestRanUeRejectsMismatchedAmfContext(t *testing.T) {
+	ranUe := NewRanUe(nil, NewRanUeNgapIdGenerator())
+	if !ranUe.BindAmfUeId(412) {
+		t.Fatal("first AMF context did not bind")
+	}
+	if ranUe.BindAmfUeId(413) {
+		t.Fatal("different AMF context was accepted")
+	}
+	if got := ranUe.GetAmfUeId(); got != 412 {
+		t.Fatalf("AMF context changed to %d, want 412", got)
+	}
+	if !ranUe.BindAmfUeId(412) {
+		t.Fatal("original AMF context was rejected")
+	}
+}
