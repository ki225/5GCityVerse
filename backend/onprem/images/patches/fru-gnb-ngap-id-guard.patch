+// BindAmfUeId rejects a stale downlink for a different AMF UE context.
+func (r *RanUe) BindAmfUeId(amfUeId int64) bool {
+	r.amfUeIdMtx.Lock()
+	defer r.amfUeIdMtx.Unlock()
+	if r.amfUeNgapId == -1 {
