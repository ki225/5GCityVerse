diff --git a/internal/sbi/server.go b/internal/sbi/server.go
--- a/internal/sbi/server.go
+++ b/internal/sbi/server.go
@@ -99,11 +99,11 @@ func newRouter(s *Server) *gin.Engine {
 }
 
 func (s *Server) Run(traceCtx context.Context, wg *sync.WaitGroup) error {
-	var err error
-	_, s.Context().NfId, err = s.Consumer().RegisterNFInstance(context.Background())
+	_, registeredID, err := s.Consumer().RegisterNFInstance(context.Background())
 	if err != nil {
 		logger.InitLog.Errorf("AUSF register to NRF Error[%s]", err.Error())
 	}
+	s.Context().NfId = registeredNfID(s.Context().NfId, registeredID, err)
 
