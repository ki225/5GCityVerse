 }
 
+func registeredNfID(currentID, registeredID string, err error) string {
+	// NRF returns 200 without a Location on update. Keep the stable local ID
+	// instead of replacing it with the empty ID returned by that path.
+	if err != nil || registeredID == "" {
+		return currentID
+	}
+	return registeredID
+}
+
 func (s *Server) Shutdown() {
 	s.shutdownHttpServer()
