 }
 
+// A failed HTTP/2 connection establishment has no HTTP response. Retrying
+// this idempotent SDM GET is safe; semantic UDM errors are not retried.
+func retryableSDMGetError(err error) bool {
+	return err != nil && strings.Contains(err.Error(), "http2: client conn could not be established")
+}
