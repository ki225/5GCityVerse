+// PUT is idempotent. Limit retries to connection establishment failure,
+// not an HTTP response or a semantic UDR rejection.
+func retryableAuthStatusPutError(err error) bool {
+	return err != nil && strings.Contains(err.Error(), "http2: client conn could not be established")
