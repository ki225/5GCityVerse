+// cancelPduSession closes the delivery window. A completion racing the timer
+// wins only if it was already committed before cancellation took the lock.
+func (r *RanUe) cancelPduSession() bool {
+	r.pduMtx.Lock()
+	defer r.pduMtx.Unlock()
+	if r.pduCompleted {
+		return false
+	}
+	r.pduCanceled = true
+	return true
+}
+
+func (r *RanUe) pduWasCompleted() bool {
+	r.pduMtx.Lock()
+	defer r.pduMtx.Unlock()
+	return r.pduCompleted
+}
+
+func (r *RanUe) writePduNas(packet []byte) (int, error) {
+	r.pduMtx.Lock()
+	defer r.pduMtx.Unlock()
+	if r.pduCanceled || r.pduCompleted {
+		return 0, fmt.Errorf("PDU establishment is no longer pending")
+	}
+	deadline := r.n1AcceptedAt.Add(40 * time.Second)
+	now := time.Now()
+	if !now.Before(deadline) {
+		r.pduCanceled = true
+		return 0, errPduCompletionTimeout
+	}
+	writeDeadline := now.Add(3 * time.Second)
+	if writeDeadline.After(deadline) {
+		writeDeadline = deadline
+	}
+	if err := r.n1Conn.SetWriteDeadline(writeDeadline); err != nil {
+		return 0, err
+	}
+	defer r.n1Conn.SetWriteDeadline(time.Time{})
+	n, err := r.n1Conn.Write(packet)
+	if err != nil {
+		return n, err
+	}
+	// The UE has received NAS Accept. Commit this under the same lock as the
+	// timeout cancellation so late delivery cannot masquerade as a timeout.
+	r.pduCompleted = true
+	r.pduSessionEstablishmentCompleteChan <- struct{}{}
+	return n, nil
+}
+
 func (r *RanUe) GetUeContextReleaseCompleteChan() chan struct{} {
 	return r.ueContextReleaseCompleteChan
+}
+
+func (r *RanUe) signalUeContextReleaseComplete() {
+	// One completion is sufficient. A timed-out waiter or released UE must
+	// never block the NGAP dispatcher, including when a duplicate arrives.
+	select {
+	case r.ueContextReleaseCompleteChan <- struct{}{}:
+	default:
+	}
 }
 
