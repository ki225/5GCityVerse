+var errPduCompletionTimeout = errors.New("PDU session establishment completion timed out")
+
+func waitPduCompletion(ranUe *RanUe) error {
+	// The UE's 45s startup deadline begins after its N1 connect returns.
+	// Budget PDU completion from that connection, not from the (possibly slow)
+	// registration that precedes the PDU request. This leaves time for the UE's
+	// failed-start deregistration to reach the RAN before the N1 read window ends.
+	timer := time.NewTimer(time.Until(ranUe.n1AcceptedAt.Add(40 * time.Second)))
+	defer timer.Stop()
+	select {
+	case <-ranUe.GetPduSessionEstablishmentCompleteChan():
+		if ranUe.pduWasCompleted() {
+			return nil
+		}
+		return errPduCompletionTimeout
+	case <-timer.C:
+		if ranUe.cancelPduSession() {
+			return errPduCompletionTimeout
+		}
+		return nil // A completed delivery won the race with the timer.
+	}
 }
 
