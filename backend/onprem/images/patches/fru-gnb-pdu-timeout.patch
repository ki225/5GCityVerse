diff --git a/gnb/pdu_timeout_test.go b/gnb/pdu_timeout_test.go
new file mode 100644
--- /dev/null
+++ b/gnb/pdu_timeout_test.go
@@ -0,0 +1,143 @@
+package gnb
+
+import (
+	"errors"
+	"net"
+	"testing"
+	"time"
+)
+
+func TestPduTimeoutCancelsLateDeliveryWithoutBlocking(t *testing.T) {
+	server, client := net.Pipe()
+	defer server.Close()
+	defer client.Close()
+	ranUe := NewRanUe(server, NewRanUeNgapIdGenerator())
+	ranUe.n1AcceptedAt = time.Now().Add(-40 * time.Second)
+	if err := waitPduCompletion(ranUe); !errors.Is(err, errPduCompletionTimeout) {
+		t.Fatalf("expected PDU timeout, got %v", err)
+	}
+	if _, err := ranUe.writePduNas([]byte{1}); err == nil {
+		t.Fatal("late PDU accept was sent after cancellation")
+	}
+	select {
+	case <-ranUe.GetPduSessionEstablishmentCompleteChan():
+		t.Fatal("late completion queued a signal")
+	default:
+	}
+}
+
+func TestPduCompletionWinsTimerRaceAndIsOneShot(t *testing.T) {
+	server, client := net.Pipe()
+	defer server.Close()
+	defer client.Close()
+	ranUe := NewRanUe(server, NewRanUeNgapIdGenerator())
+	read := make(chan struct{})
+	go func() { _, _ = client.Read(make([]byte, 1)); close(read) }()
+	if _, err := ranUe.writePduNas([]byte{1}); err != nil {
+		t.Fatalf("first NAS Accept was rejected: %v", err)
+	}
+	<-read
+	ranUe.n1AcceptedAt = time.Now().Add(-40 * time.Second)
+	if err := waitPduCompletion(ranUe); err != nil {
+		t.Fatalf("committed completion was lost: %v", err)
+	}
+	if ranUe.cancelPduSession() {
+		t.Fatal("completed PDU was later canceled")
+	}
+	if _, err := ranUe.writePduNas([]byte{1}); err == nil {
+		t.Fatal("duplicate NAS Accept was accepted")
+	}
+}
+
+func TestPduCompletionAndCancellationRaceHasOneOutcome(t *testing.T) {
+	for i := 0; i < 200; i++ {
+		server, client := net.Pipe()
+		ranUe := NewRanUe(server, NewRanUeNgapIdGenerator())
+		ranUe.n1AcceptedAt = time.Now().Add(-40*time.Second + 10*time.Millisecond)
+		go func() { _, _ = client.Read(make([]byte, 1)) }()
+		complete := make(chan error, 1)
+		go func() {
+			_, err := ranUe.writePduNas([]byte{1})
+			complete <- err
+		}()
+		err := waitPduCompletion(ranUe)
+		accepted := <-complete == nil
+		server.Close()
+		client.Close()
+		if errors.Is(err, errPduCompletionTimeout) == accepted {
+			t.Fatalf("iteration %d: timeout=%v, completion accepted=%v", i, err, accepted)
+		}
+	}
+}
+
+func TestSlowRegistrationUsesConnectionDeadline(t *testing.T) {
+	server, client := net.Pipe()
+	defer server.Close()
+	defer client.Close()
+	ranUe := NewRanUe(server, NewRanUeNgapIdGenerator())
+	// Simulate a registration that consumed more than the entire PDU budget.
+	// A timeout measured from the PDU request would wait another 40 seconds.
+	ranUe.n1AcceptedAt = time.Now().Add(-44 * time.Second)
+	if _, err := ranUe.writePduNas([]byte{1}); !errors.Is(err, errPduCompletionTimeout) {
+		t.Fatalf("late NGAP completion bypassed the absolute deadline: %v", err)
+	}
+	started := time.Now()
+	if err := waitPduCompletion(ranUe); !errors.Is(err, errPduCompletionTimeout) {
+		t.Fatalf("slow registration must exhaust the shared deadline: %v", err)
+	}
+	if elapsed := time.Since(started); elapsed > time.Second {
+		t.Fatalf("PDU wait restarted after slow registration: %v", elapsed)
+	}
+	if _, err := ranUe.writePduNas([]byte{1}); err == nil {
+		t.Fatal("late completion wrote NAS after the shared deadline")
+	}
+}
+
+func TestClosedN1CannotCommitPduCompletion(t *testing.T) {
+	server, client := net.Pipe()
+	ranUe := NewRanUe(server, NewRanUeNgapIdGenerator())
+	client.Close()
+	if _, err := ranUe.writePduNas([]byte{1}); err == nil {
+		t.Fatal("closed N1 connection accepted PDU NAS")
+	}
+	ranUe.n1AcceptedAt = time.Now().Add(-40 * time.Second)
+	if err := waitPduCompletion(ranUe); !errors.Is(err, errPduCompletionTimeout) {
+		t.Fatalf("closed connection committed PDU completion: %v", err)
+	}
+	server.Close()
+}
+
+func TestLateAmfReleaseSignalRacesRanUeReleaseWithoutBlocking(t *testing.T) {
+	for i := 0; i < 200; i++ {
+		ids := NewRanUeNgapIdGenerator()
+		ranUe := NewRanUe(nil, ids)
+		teids := NewTeidGenerator()
+		start := make(chan struct{})
+		done := make(chan struct{}, 2)
+		go func() {
+			<-start
+			ranUe.signalUeContextReleaseComplete()
+			done <- struct{}{}
+		}()
+		go func() {
+			<-start
+			ranUe.Release(ids, teids)
+			done <- struct{}{}
+		}()
+		close(start)
+		for j := 0; j < 2; j++ {
+			select {
+			case <-done:
+			case <-time.After(time.Second):
+				t.Fatalf("iteration %d: late AMF signal or UE release blocked", i)
+			}
+		}
+		// A duplicate arriving after Release must also be safe and nonblocking.
+		ranUe.signalUeContextReleaseComplete()
+		select {
+		case <-ranUe.GetUeContextReleaseCompleteChan():
+		default:
+			t.Fatalf("iteration %d: completion signal was lost", i)
+		}
+	}
+}
