diff --git a/internal/sbi/consumer/udr_read_retry.go b/internal/sbi/consumer/udr_read_retry.go
new file mode 100644
--- /dev/null
+++ b/internal/sbi/consumer/udr_read_retry.go
@@ -0,0 +1,36 @@
+package consumer
+
+import (
+	"context"
+	"errors"
+	"net/url"
+	"strings"
+	"time"
+)
+
+// Only the two idempotent policy-data GET callers use this helper.
+// HTTP responses and policy mutations retain their original handling.
+func udrReadWithSetupRetry[T any](ctx context.Context, request func() (T, error)) (result T, err error) {
+	for attempt := 0; attempt < 3; attempt++ {
+		if err = ctx.Err(); err != nil {
+			return
+		}
+		result, err = request()
+		if err == nil || attempt == 2 {
+			return
+		}
+		var transportError *url.Error
+		if !errors.As(err, &transportError) || !strings.Contains(transportError.Err.Error(), "http2: client conn could not be established") {
+			return
+		}
+		timer := time.NewTimer(time.Duration(attempt+1) * 50 * time.Millisecond)
+		select {
+		case <-ctx.Done():
+			timer.Stop()
+			err = ctx.Err()
+			return
+		case <-timer.C:
+		}
+	}
+	return
+}
