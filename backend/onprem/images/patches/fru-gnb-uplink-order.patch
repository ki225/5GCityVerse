diff --git a/gnb/ordered_uplink.go b/gnb/ordered_uplink.go
new file mode 100644
--- /dev/null
+++ b/gnb/ordered_uplink.go
@@ -0,0 +1,77 @@
+package gnb
+
+import (
+	"context"
+	"hash/fnv"
+	"net"
+	"sync"
+)
+
+const (
+	uplinkLaneCount = 64
+	uplinkLaneDepth = 128
+)
+
+type uplinkDatagram struct {
+	address *net.UDPAddr
+	payload []byte
+}
+
+// orderedUplink keeps each UE address on one FIFO worker while bounding both
+// worker and queued packet counts. Different addresses can use different lanes.
+type orderedUplink struct {
+	ctx    context.Context
+	cancel context.CancelFunc
+	lanes  []chan uplinkDatagram
+	wg     sync.WaitGroup
+}
+
+func newOrderedUplink(parent context.Context, laneCount, laneDepth int, process func(uplinkDatagram)) *orderedUplink {
+	ctx, cancel := context.WithCancel(parent)
+	u := &orderedUplink{
+		ctx:    ctx,
+		cancel: cancel,
+		lanes:  make([]chan uplinkDatagram, laneCount),
+	}
+	for i := range u.lanes {
+		lane := make(chan uplinkDatagram, laneDepth)
+		u.lanes[i] = lane
+		u.wg.Add(1)
+		go func() {
+			defer u.wg.Done()
+			for {
+				select {
+				case <-ctx.Done():
+					return
+				case packet := <-lane:
+					if ctx.Err() != nil {
+						return
+					}
+					process(packet)
+				}
+			}
+		}()
+	}
+	return u
+}
+
+func (u *orderedUplink) enqueue(packet uplinkDatagram) bool {
+	if u.ctx.Err() != nil {
+		return false
+	}
+	hash := fnv.New32a()
+	_, _ = hash.Write([]byte(packet.address.String()))
+	lane := u.lanes[int(hash.Sum32())%len(u.lanes)]
+	select {
+	case <-u.ctx.Done():
+		return false
+	case lane <- packet:
+		return true
+	default:
+		return false
+	}
+}
+
+func (u *orderedUplink) wait() {
+	u.wg.Wait()
+}
diff --git a/gnb/ordered_uplink_test.go b/gnb/ordered_uplink_test.go
new file mode 100644
--- /dev/null
+++ b/gnb/ordered_uplink_test.go
@@ -0,0 +1,83 @@
+package gnb
+
+import (
+	"context"
+	"net"
+	"sync"
+	"testing"
+	"time"
+)
+
+func TestOrderedUplinkPreservesAddressOrder(t *testing.T) {
+	var mu sync.Mutex
+	got := make([]byte, 0, 200)
+	done := make(chan struct{})
+	u := newOrderedUplink(context.Background(), 4, 256, func(packet uplinkDatagram) {
+		mu.Lock()
+		got = append(got, packet.payload[0])
+		if len(got) == 200 {
+			close(done)
+		}
+		mu.Unlock()
+	})
+	defer func() { u.cancel(); u.wait() }()
+	address := &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1), Port: 10001}
+	for i := 0; i < 200; i++ {
+		if !u.enqueue(uplinkDatagram{address: address, payload: []byte{byte(i)}}) {
+			t.Fatalf("packet %d rejected", i)
+		}
+	}
+	select {
+	case <-done:
+	case <-time.After(2 * time.Second):
+		t.Fatal("ordered worker did not drain packets")
+	}
+	mu.Lock()
+	defer mu.Unlock()
+	for i, value := range got {
+		if value != byte(i) {
+			t.Fatalf("packet %d arrived as %d", i, value)
+		}
+	}
+}
+
+func TestOrderedUplinkOtherLaneProgressAndBoundedQueue(t *testing.T) {
+	first := &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1), Port: 10001}
+	second := &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1), Port: 10002}
+	started := make(chan struct{})
+	release := make(chan struct{})
+	otherDone := make(chan struct{})
+	u := newOrderedUplink(context.Background(), 64, 1, func(packet uplinkDatagram) {
+		if packet.address.String() == first.String() {
+			if packet.payload[0] == 1 {
+				close(started)
+				<-release
+			}
+			return
+		}
+		close(otherDone)
+	})
+	defer func() { close(release); u.cancel(); u.wait() }()
+	if !u.enqueue(uplinkDatagram{address: first, payload: []byte{1}}) {
+		t.Fatal("first packet rejected")
+	}
+	select {
+	case <-started:
+	case <-time.After(2 * time.Second):
+		t.Fatal("first lane did not start")
+	}
+	if !u.enqueue(uplinkDatagram{address: first, payload: []byte{2}}) {
+		t.Fatal("bounded lane should hold one queued packet")
+	}
+	if u.enqueue(uplinkDatagram{address: first, payload: []byte{3}}) {
+		t.Fatal("bounded lane accepted packet beyond capacity")
+	}
+	if !u.enqueue(uplinkDatagram{address: second, payload: []byte{4}}) {
+		t.Fatal("second UE packet rejected")
+	}
+	select {
+	case <-otherDone:
+	case <-time.After(2 * time.Second):
+		t.Fatal("other UE did not progress while first UE was blocked")
+	}
+}
