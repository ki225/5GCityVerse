+func TestInitialContextSetupWireDiagnostic(t *testing.T) {
+ oldConfig := factory.AmfConfig
+ factory.AmfConfig = &factory.Config{Configuration:&factory.Configuration{}}
+ defer func(){factory.AmfConfig=oldConfig}()
+ self:=context.GetSelf()
+ oldGuami:=self.ServedGuamiList
+ self.ServedGuamiList=[]models.Guami{{PlmnId:&models.PlmnIdNid{Mcc:"208",Mnc:"93"},AmfId:"cafe00"}}
+ defer func(){self.ServedGuamiList=oldGuami}()
+ access:=models.AccessType__3_GPP_ACCESS
+ for _, empty :=range []bool{false,true} {
+  ue:=&context.AmfUe{Kgnb:make([]byte,32),
+    UESecurityCapability:nasType.UESecurityCapability{Buffer:[]byte{0x80,0x80}},
+    RanUe:map[models.AccessType]*context.RanUe{access:{AmfUeNgapId:1,RanUeNgapId:1,Ran:&context.AmfRan{AnType:access}}},
+    AllowedNssai:map[models.AccessType][]models.AllowedSnssai{}}
+  if !empty {ue.AllowedNssai[access]=[]models.AllowedSnssai{{AllowedSnssai:&models.Snssai{Sst:3,Sd:"000004"}}}}
+  raw,err:=BuildInitialContextSetupRequest(ue,access,[]byte{0x7e,0,0x42},nil,nil,nil,nil)
+  if empty {
+   if err==nil || len(raw)!=0 || !strings.Contains(err.Error(),"initial_context_setup.ie_0:") || !strings.Contains(err.Error(),"lowerbound") {
+    t.Fatalf("empty mandatory AllowedNSSAI must identify its IE and return no packet: %v",err)
+   }
+  } else {
+   if err!=nil {t.Fatal(err)}
+   decoded,decodeErr:=ngap.Decoder(raw)
+   if decodeErr!=nil {t.Fatal(decodeErr)}
+   found:=false
+   for _,ie:=range decoded.InitiatingMessage.Value.InitialContextSetupRequest.ProtocolIEs.List {
+    if ie.Id.Value==ngapType.ProtocolIEIDAllowedNSSAI {found=len(ie.Value.AllowedNSSAI.List)==1}
+   }
+   if !found {t.Fatal("valid full packet lost AllowedNSSAI")}
+  }
+ }
