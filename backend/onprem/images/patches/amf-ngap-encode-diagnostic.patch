+
+// encodeInitialContextSetupDiagnostic preserves the full packet and its error.
+// Isolated IE encodings run only after failure, solely to identify the invalid
+// field. No partial packet is returned or transmitted, and no UE data is logged.
+func encodeInitialContextSetupDiagnostic(pdu ngapType.NGAPPDU) ([]byte, error) {
+    encoded, err := ngap.Encoder(pdu)
+    if err == nil { return encoded, nil }
+    request := pdu.InitiatingMessage.Value.InitialContextSetupRequest
+    all := request.ProtocolIEs.List
+    defer func() { request.ProtocolIEs.List = all }()
+    for _, ie := range all {
+        request.ProtocolIEs.List = []ngapType.InitialContextSetupRequestIEs{ie}
+        if _, fieldErr := ngap.Encoder(pdu); fieldErr != nil {
+            return nil, fmt.Errorf("initial_context_setup.ie_%d: %w", ie.Id.Value, err)
+        }
+    }
+    return nil, fmt.Errorf("initial_context_setup.unclassified: %w", err)
+}
