+// Authentication subscription lookup is an idempotent GET. Retry only a
+// failed HTTP/2 connection establishment; never retry a UDR HTTP response.
+func queryAuthSubsDataWithRetry[T any](ctx context.Context, query func() (T, error)) (T, error) {
+	var result T
+	var err error
+	for attempt := 0; attempt < 3; attempt++ {
+		result, err = query()
+		if err == nil || !retryableAuthSubsGetError(err) || attempt == 2 {
+			return result, err
+		}
+		logger.UeauLog.Warnf("Transient UDR authentication GET connection failure; retry %d/2", attempt+1)
+		timer := time.NewTimer(time.Duration(50*(attempt+1)) * time.Millisecond)
+		select {
+		case <-ctx.Done():
+			timer.Stop()
+			return result, ctx.Err()
+		case <-timer.C:
+		}
+	}
+	return result, err
+}
+
+func retryableAuthSubsGetError(err error) bool {
+	return err != nil && strings.Contains(err.Error(), "http2: client conn could not be established")
+}
diff --git a/internal/sbi/processor/auth_subs_get_retry_test.go b/internal/sbi/processor/auth_subs_get_retry_test.go
new file mode 100644
--- /dev/null
+++ b/internal/sbi/processor/auth_subs_get_retry_test.go
@@ -0,0 +1,45 @@
+package processor
+
+import (
+	"context"
+	"errors"
+	"testing"
+)
+
+func TestQueryAuthSubsDataRetriesConnectionEstablishmentOnly(t *testing.T) {
+	connectionError := errors.New(`Get "http://udr/authentication-subscription": http2: client conn could not be established`)
+	attempts := 0
+	value, err := queryAuthSubsDataWithRetry(context.Background(), func() (int, error) {
+		attempts++
+		if attempts < 3 {
+			return 0, connectionError
+		}
+		return 42, nil
+	})
+	if err != nil || value != 42 || attempts != 3 {
+		t.Fatalf("value=%d err=%v attempts=%d; want 42, nil, 3", value, err, attempts)
+	}
+
+	attempts = 0
+	semanticError := errors.New("UDR returned 403")
+	_, err = queryAuthSubsDataWithRetry(context.Background(), func() (int, error) {
+		attempts++
+		return 0, semanticError
+	})
+	if !errors.Is(err, semanticError) || attempts != 1 {
+		t.Fatalf("semantic error retried: err=%v attempts=%d", err, attempts)
+	}
+}
+
+func TestQueryAuthSubsDataStopsOnCancelledContext(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	attempts := 0
+	_, err := queryAuthSubsDataWithRetry(ctx, func() (int, error) {
+		attempts++
+		cancel()
+		return 0, errors.New("http2: client conn could not be established")
+	})
+	if !errors.Is(err, context.Canceled) || attempts != 1 {
+		t.Fatalf("cancelled GET retried: err=%v attempts=%d", err, attempts)
+	}
+}
