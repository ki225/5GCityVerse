diff --git a/internal/sbi/consumer/nssf_retry_test.go b/internal/sbi/consumer/nssf_retry_test.go
new file mode 100644
index 0000000..1fdb1b1
--- /dev/null
+++ b/internal/sbi/consumer/nssf_retry_test.go
@@ -0,0 +1,87 @@
+package consumer
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net/url"
+	"testing"
+
+	"github.com/free5gc/openapi"
+	Nnssf_NSSelection "github.com/free5gc/openapi/nssf/NSSelection"
+)
+
+func TestNssfPduGetRetryFirstNewConnectionFailure(t *testing.T) {
+	calls, logged := 0, 0
+	want := &Nnssf_NSSelection.NSSelectionGetResponse{}
+	got, err := retryNssfPduSelectionGet(context.Background(),
+		func(context.Context) (*Nnssf_NSSelection.NSSelectionGetResponse, error) {
+			calls++
+			if calls == 1 {
+				return nil, &url.Error{Op: "Get", URL: "http://nssf:8000", Err: errors.New("http2: client conn could not be established")}
+			}
+			return want, nil
+		}, func(error) { logged++ })
+	if err != nil || got != want || calls != 2 || logged != 1 {
+		t.Fatalf("response=%p error=%v calls=%d logged=%d", got, err, calls, logged)
+	}
+}
+
+func TestNssfPduGetDoesNotRetrySemanticResponse(t *testing.T) {
+	for _, status := range []int{400, 404, 500} {
+		t.Run(fmt.Sprint(status), func(t *testing.T) {
+			calls := 0
+			semantic := openapi.GenericOpenAPIError{ErrorStatus: status}
+			_, err := retryNssfPduSelectionGet(context.Background(),
+				func(context.Context) (*Nnssf_NSSelection.NSSelectionGetResponse, error) {
+					calls++
+					return nil, semantic
+				}, nil)
+			if err == nil || calls != 1 {
+				t.Fatalf("error=%v calls=%d", err, calls)
+			}
+		})
+	}
+}
+
+func TestNssfPduGetDoesNotRetryOtherTransportError(t *testing.T) {
+	calls := 0
+	_, _ = retryNssfPduSelectionGet(context.Background(),
+		func(context.Context) (*Nnssf_NSSelection.NSSelectionGetResponse, error) {
+			calls++
+			return nil, &url.Error{Op: "Get", URL: "http://nssf:8000", Err: errors.New("connection refused")}
+		}, nil)
+	if calls != 1 {
+		t.Fatalf("calls=%d", calls)
+	}
+}
+
+func TestNssfPduGetTransientThenSemanticResponsePreservesType(t *testing.T) {
+	calls := 0
+	_, err := retryNssfPduSelectionGet(context.Background(),
+		func(context.Context) (*Nnssf_NSSelection.NSSelectionGetResponse, error) {
+			calls++
+			if calls == 1 {
+				return nil, &url.Error{Op: "Get", URL: "http://nssf:8000", Err: errors.New("http2: client conn could not be established")}
+			}
+			return nil, openapi.GenericOpenAPIError{ErrorStatus: 400}
+		}, nil)
+	_, concrete := err.(openapi.GenericOpenAPIError)
+	if !concrete || calls != 2 {
+		t.Fatalf("error=%T %v calls=%d", err, err, calls)
+	}
+}
+
+func TestNssfPduGetCancelledContextPreventsRetry(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	calls := 0
+	_, err := retryNssfPduSelectionGet(ctx,
+		func(context.Context) (*Nnssf_NSSelection.NSSelectionGetResponse, error) {
+			calls++
+			cancel()
+			return nil, &url.Error{Op: "Get", URL: "http://nssf:8000", Err: errors.New("http2: client conn could not be established")}
+		}, nil)
+	if !errors.Is(err, context.Canceled) || calls != 1 {
+		t.Fatalf("error=%v calls=%d", err, calls)
+	}
+}
