+// retryNssfPduSelectionGet is only for the idempotent NSSF selection GET.
+// x/net/http2 emits this error when a new ClientConn closes before its first
+// request is sent; no NSSF response or side effect can have occurred.
+func retryNssfPduSelectionGet(ctx context.Context,
+	get func(context.Context) (*Nnssf_NSSelection.NSSelectionGetResponse, error),
+	onRetry func(error),
+) (*Nnssf_NSSelection.NSSelectionGetResponse, error) {
+	ctx, cancel := context.WithTimeout(ctx, 21*time.Second)
+	defer cancel()
+	response, firstErr := get(ctx)
+	if !isNssfNewConnectionFailure(firstErr) {
+		return response, firstErr
+	}
+	if err := ctx.Err(); err != nil {
+		return nil, fmt.Errorf("NSSF GET transport failure %v; retry cancelled: %w", firstErr, err)
+	}
+	if onRetry != nil {
+		onRetry(firstErr)
+	}
+	timer := time.NewTimer(100 * time.Millisecond)
+	defer timer.Stop()
+	select {
+	case <-timer.C:
+	case <-ctx.Done():
+		return nil, fmt.Errorf("NSSF GET transport failure %v; retry cancelled: %w", firstErr, ctx.Err())
+	}
+	if err := ctx.Err(); err != nil {
+		return nil, fmt.Errorf("NSSF GET transport failure %v; retry cancelled: %w", firstErr, err)
+	}
+	response, retryErr := get(ctx)
+	if retryErr != nil {
+		// Preserve GenericOpenAPIError's concrete type: the caller maps its
+		// ProblemDetails via a direct type switch. The first error was logged.
+		return nil, retryErr
+	}
+	return response, nil
+}
+
+func isNssfNewConnectionFailure(err error) bool {
+	if err == nil {
+		return false
+	}
+	var apiErr openapi.GenericOpenAPIError
+	if errors.As(err, &apiErr) { // any NSSF HTTP response is semantic, never retry
+		return false
+	}
+	var urlErr *url.Error
+	return errors.As(err, &urlErr) && urlErr.Err != nil &&
+		strings.Contains(urlErr.Err.Error(), "http2: client conn could not be established")
+}
