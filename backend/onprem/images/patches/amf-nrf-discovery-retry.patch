+// NRF discovery is an idempotent GET. A failed HTTP/2 connection setup is
+// retryable; an actual NRF response is not.
+func retryableAMFNRFDiscoveryError(err error) bool {
+	return err != nil && strings.Contains(err.Error(), "http2: client conn could not be established")
