+package context
+
+import "testing"
+
+// Derived from free5gc/amf PR #240 (open/unmerged), adapted to release pin.
+func TestCityverseStaleRemoveKeepsReplacement(t *testing.T) {
+	self := GetSelf()
+	oldUE := &AmfUe{Supi: "imsi-208930100009001"}
+	newUE := &AmfUe{Supi: oldUE.Supi}
+	self.UePool.Store(newUE.Supi, newUE)
+	t.Cleanup(func() { self.UePool.CompareAndDelete(newUE.Supi, newUE) })
+	oldUE.Remove()
+	got, ok := self.AmfUeFindBySupi(newUE.Supi)
+	if !ok || got != newUE {
+		t.Fatal("stale removal deleted or replaced the newer SUPI owner")
+	}
+}
+
+func TestCityverseCurrentRemoveDeletesOwnEntry(t *testing.T) {
+	self := GetSelf()
+	ue := &AmfUe{Supi: "imsi-208930100009002"}
+	self.UePool.Store(ue.Supi, ue)
+	t.Cleanup(func() { self.UePool.CompareAndDelete(ue.Supi, ue) })
+	ue.Remove()
+	if _, ok := self.AmfUeFindBySupi(ue.Supi); ok {
+		t.Fatal("normal removal retained its own SUPI entry")
+	}
+}
