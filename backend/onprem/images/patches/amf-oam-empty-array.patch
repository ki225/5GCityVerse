+package processor
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/gin-gonic/gin"
+	"github.com/stretchr/testify/require"
+)
+
+func TestOAMRegisteredUEContextJSONShape(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+
+	t.Run("empty inventory is an array", func(t *testing.T) {
+		recorder := httptest.NewRecorder()
+		requestContext, _ := gin.CreateTestContext(recorder)
+
+		(&Processor{}).HandleOAMRegisteredUEContext(requestContext)
+
+		require.Equal(t, http.StatusOK, recorder.Code)
+		require.JSONEq(t, `[]`, recorder.Body.String())
+	})
+
+	t.Run("nonempty inventory remains an array", func(t *testing.T) {
+		encoded, err := json.Marshal(UEContexts{{Supi: "test-supi"}})
+		require.NoError(t, err)
+
+		var decoded []UEContext
+		require.NoError(t, json.Unmarshal(encoded, &decoded))
+		require.Len(t, decoded, 1)
+		require.Equal(t, "test-supi", decoded[0].Supi)
+	})
+}
