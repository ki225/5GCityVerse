diff --git a/internal/context/recovery_quarantine.go b/internal/context/recovery_quarantine.go
new file mode 100644
index 0000000..699bc8a
--- /dev/null
+++ b/internal/context/recovery_quarantine.go
@@ -0,0 +1,189 @@
+package context
+
+import (
+	"crypto/rand"
+	"encoding/hex"
+	"errors"
+	"sync"
+	"time"
+)
+
+const (
+	uePoolIndex = iota
+	appSessionPoolIndex
+	bdtPolicyPoolIndex
+	amfStatusPoolIndex
+	poolCount
+)
+
+// GuardedPool deliberately does not embed sync.Map. A new mutation method
+// must be added here and reviewed against the same gate before it can compile.
+type GuardedPool struct {
+	data  sync.Map
+	gate  *recoveryMutationGate
+	index int
+}
+
+func (p *GuardedPool) Load(key any) (any, bool)    { return p.data.Load(key) }
+func (p *GuardedPool) Range(f func(any, any) bool) { p.data.Range(f) }
+
+func (p *GuardedPool) Store(key, value any) {
+	if p.gate == nil {
+		p.data.Store(key, value)
+		return
+	}
+	p.gate.mu.Lock()
+	defer p.gate.mu.Unlock()
+	p.gate.attemptedStores[p.index]++
+	if p.gate.active {
+		p.gate.deniedStores[p.index]++
+		return
+	}
+	p.data.Store(key, value)
+}
+
+func (p *GuardedPool) Delete(key any) {
+	if p.gate == nil {
+		p.data.Delete(key)
+		return
+	}
+	p.gate.mu.Lock()
+	defer p.gate.mu.Unlock()
+	p.gate.attemptedDeletes[p.index]++
+	if p.gate.active {
+		p.gate.deniedDeletes[p.index]++
+		return
+	}
+	p.data.Delete(key)
+}
+
+type recoveryMutationGate struct {
+	mu               sync.Mutex
+	active           bool
+	epoch            string
+	boot             BootReceipt
+	attemptedStores  [poolCount]uint64
+	attemptedDeletes [poolCount]uint64
+	deniedStores     [poolCount]uint64
+	deniedDeletes    [poolCount]uint64
+}
+
+type RecoveryPoolCounts struct {
+	UE            int `json:"ue"`
+	AppSession    int `json:"appSession"`
+	BdtPolicy     int `json:"bdtPolicy"`
+	AmfStatusSubs int `json:"amfStatusSubs"`
+}
+
+type RecoveryMutationCounter struct {
+	AttemptedStores  uint64 `json:"attemptedStores"`
+	AttemptedDeletes uint64 `json:"attemptedDeletes"`
+	DeniedStores     uint64 `json:"deniedStores"`
+	DeniedDeletes    uint64 `json:"deniedDeletes"`
+}
+
+type RecoveryMutationCounts struct {
+	UE            RecoveryMutationCounter `json:"ue"`
+	AppSession    RecoveryMutationCounter `json:"appSession"`
+	BdtPolicy     RecoveryMutationCounter `json:"bdtPolicy"`
+	AmfStatusSubs RecoveryMutationCounter `json:"amfStatusSubs"`
+}
+
+type RecoveryCurrentReceipt struct {
+	SchemaVersion              string                 `json:"schemaVersion"`
+	Source                     string                 `json:"source"`
+	PodUID                     string                 `json:"podUid"`
+	BootEpoch                  string                 `json:"bootEpoch"`
+	GateEpoch                  string                 `json:"gateEpoch"`
+	BinarySHA256               string                 `json:"binarySha256"`
+	ObservedAt                 string                 `json:"observedAt"`
+	QuarantineActive           bool                   `json:"quarantineActive"`
+	InventoryComplete          bool                   `json:"inventoryComplete"`
+	InventoryScope             string                 `json:"inventoryScope"`
+	CurrentZero                bool                   `json:"currentZero"`
+	Pools                      RecoveryPoolCounts     `json:"pools"`
+	Mutations                  RecoveryMutationCounts `json:"mutations"`
+	PriorEpochState            string                 `json:"priorEpochState"`
+	ExternalPolicyState        string                 `json:"externalPolicyState"`
+	PriorEpochExternalNRFState string                 `json:"priorEpochExternalNrfState"`
+	NRFRegistrationState       string                 `json:"nrfRegistrationState"`
+}
+
+func (c *PCFContext) recoveryPools() [poolCount]*GuardedPool {
+	return [poolCount]*GuardedPool{&c.UePool, &c.AppSessionPool,
+		&c.BdtPolicyPool, &c.AMFStatusSubsData}
+}
+
+func currentCounts(pools [poolCount]*GuardedPool) [poolCount]int {
+	var counts [poolCount]int
+	for i, pool := range pools {
+		pool.data.Range(func(_, _ any) bool { counts[i]++; return true })
+	}
+	return counts
+}
+
+func (g *recoveryMutationGate) mutationCounter(index int) RecoveryMutationCounter {
+	return RecoveryMutationCounter{g.attemptedStores[index], g.attemptedDeletes[index],
+		g.deniedStores[index], g.deniedDeletes[index]}
+}
+
+// EnableRecoveryQuarantine is called only by NewApp, after the pre-listener
+// boot receipt and before NewServer, NRF registration, or policy handlers.
+// There is no writer during this initialization phase.
+func (c *PCFContext) EnableRecoveryQuarantine(boot BootReceipt) error {
+	if c == nil || c.recoveryGate != nil || !boot.PreListenerPoolsEmpty ||
+		!podUIDPattern.MatchString(boot.PodUID) || boot.BootEpoch == "" ||
+		boot.PriorEpochState != "unknown" {
+		return errors.New("PCF recovery quarantine boot identity unavailable or replayed")
+	}
+	pools := c.recoveryPools()
+	if currentCounts(pools) != [poolCount]int{} {
+		return errors.New("PCF recovery quarantine requires four empty pools")
+	}
+	nonce := make([]byte, 16)
+	if _, err := rand.Read(nonce); err != nil {
+		return err
+	}
+	gate := &recoveryMutationGate{active: true, epoch: hex.EncodeToString(nonce), boot: boot}
+	for i, pool := range pools {
+		pool.index, pool.gate = i, gate
+	}
+	c.recoveryGate = gate
+	return nil
+}
+
+func (c *PCFContext) RecoveryQuarantineEnabled() bool {
+	return c != nil && c.recoveryGate != nil && c.recoveryGate.active
+}
+
+// CurrentRecoveryReceipt uses the same mutation gate as all four pool writes.
+// It proves only this process's current in-memory pool membership.
+func (c *PCFContext) CurrentRecoveryReceipt() (RecoveryCurrentReceipt, bool) {
+	if !c.RecoveryQuarantineEnabled() {
+		return RecoveryCurrentReceipt{}, false
+	}
+	gate := c.recoveryGate
+	gate.mu.Lock()
+	defer gate.mu.Unlock()
+	counts := currentCounts(c.recoveryPools())
+	return RecoveryCurrentReceipt{
+		SchemaVersion: "cityverse.pcf-recovery-current/v1",
+		Source:        "pcf-process-quarantine-current", PodUID: gate.boot.PodUID,
+		BootEpoch: gate.boot.BootEpoch, GateEpoch: gate.epoch,
+		BinarySHA256:     gate.boot.BinarySHA256,
+		ObservedAt:       time.Now().UTC().Format(time.RFC3339Nano),
+		QuarantineActive: true, InventoryComplete: true,
+		InventoryScope: "current-pcf-process-four-pools-only",
+		CurrentZero:    counts == [poolCount]int{},
+		Pools: RecoveryPoolCounts{UE: counts[uePoolIndex],
+			AppSession: counts[appSessionPoolIndex], BdtPolicy: counts[bdtPolicyPoolIndex],
+			AmfStatusSubs: counts[amfStatusPoolIndex]},
+		Mutations: RecoveryMutationCounts{UE: gate.mutationCounter(uePoolIndex),
+			AppSession:    gate.mutationCounter(appSessionPoolIndex),
+			BdtPolicy:     gate.mutationCounter(bdtPolicyPoolIndex),
+			AmfStatusSubs: gate.mutationCounter(amfStatusPoolIndex)},
+		PriorEpochState: "unknown", ExternalPolicyState: "unknown",
+		PriorEpochExternalNRFState: "unknown",
+		NRFRegistrationState:       "disabled-by-quarantine",
+	}, true
+}
diff --git a/internal/context/recovery_quarantine_test.go b/internal/context/recovery_quarantine_test.go
new file mode 100644
index 0000000..9e4c2b0
--- /dev/null
+++ b/internal/context/recovery_quarantine_test.go
@@ -0,0 +1,105 @@
+package context
+
+import (
+	"sync"
+	"testing"
+)
+
+func quarantineTestContext(t *testing.T) *PCFContext {
+	t.Helper()
+	c := &PCFContext{NfId: "pcf-quarantine-test"}
+	boot, err := newBootReceipt(c, testPodUID, testBinary(t))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := c.EnableRecoveryQuarantine(boot); err != nil {
+		t.Fatal(err)
+	}
+	return c
+}
+
+func TestRecoveryQuarantineAllFourPools(t *testing.T) {
+	c := quarantineTestContext(t)
+	for _, pool := range c.recoveryPools() {
+		pool.Store("new", "policy")
+		pool.Delete("new")
+		if _, ok := pool.Load("new"); ok {
+			t.Fatal("quarantined mutation entered pool")
+		}
+	}
+	r, ok := c.CurrentRecoveryReceipt()
+	if !ok || !r.InventoryComplete || !r.CurrentZero || !r.QuarantineActive ||
+		r.Pools != (RecoveryPoolCounts{}) || r.PodUID != testPodUID ||
+		r.BootEpoch == "" || r.GateEpoch == "" || r.ObservedAt == "" ||
+		r.PriorEpochState != "unknown" || r.ExternalPolicyState != "unknown" ||
+		r.PriorEpochExternalNRFState != "unknown" ||
+		r.InventoryScope != "current-pcf-process-four-pools-only" {
+		t.Fatalf("invalid current receipt: %+v", r)
+	}
+	for _, count := range []RecoveryMutationCounter{r.Mutations.UE, r.Mutations.AppSession,
+		r.Mutations.BdtPolicy, r.Mutations.AmfStatusSubs} {
+		if count != (RecoveryMutationCounter{1, 1, 1, 1}) {
+			t.Fatalf("mutation counts: %+v", count)
+		}
+	}
+	if err := c.EnableRecoveryQuarantine(BootReceipt{}); err == nil {
+		t.Fatal("replay accepted")
+	}
+}
+
+func TestRecoveryQuarantineRequiresEmptyFourthPool(t *testing.T) {
+	c := &PCFContext{NfId: "pcf-quarantine-test"}
+	c.AMFStatusSubsData.Store("old", "subscription")
+	boot := BootReceipt{PodUID: testPodUID, BootEpoch: "epoch", PreListenerPoolsEmpty: true,
+		PriorEpochState: "unknown"}
+	if err := c.EnableRecoveryQuarantine(boot); err == nil {
+		t.Fatal("populated fourth pool accepted")
+	}
+	if _, ok := c.CurrentRecoveryReceipt(); ok {
+		t.Fatal("current receipt without gate")
+	}
+}
+
+func TestRecoveryQuarantineConcurrentMutationAndSnapshot(t *testing.T) {
+	c := quarantineTestContext(t)
+	var workers sync.WaitGroup
+	for _, pool := range c.recoveryPools() {
+		workers.Add(1)
+		go func(p *GuardedPool) {
+			defer workers.Done()
+			for i := 0; i < 100; i++ {
+				p.Store(i, i)
+				p.Delete(i)
+			}
+		}(pool)
+	}
+	for i := 0; i < 100; i++ {
+		r, ok := c.CurrentRecoveryReceipt()
+		if !ok || !r.CurrentZero || r.Pools != (RecoveryPoolCounts{}) {
+			t.Fatal("nonzero concurrent inventory")
+		}
+	}
+	workers.Wait()
+	r, _ := c.CurrentRecoveryReceipt()
+	for _, count := range []RecoveryMutationCounter{r.Mutations.UE, r.Mutations.AppSession,
+		r.Mutations.BdtPolicy, r.Mutations.AmfStatusSubs} {
+		if count != (RecoveryMutationCounter{100, 100, 100, 100}) {
+			t.Fatalf("lost mutation count: %+v", count)
+		}
+	}
+}
+
+func TestRecoveryDefaultPoolBehavior(t *testing.T) {
+	c := &PCFContext{}
+	c.AMFStatusSubsData.Store("key", "value")
+	if value, ok := c.AMFStatusSubsData.Load("key"); !ok || value != "value" {
+		t.Fatal("default store changed")
+	}
+	c.AMFStatusSubsData.Delete("key")
+	if _, ok := c.AMFStatusSubsData.Load("key"); ok {
