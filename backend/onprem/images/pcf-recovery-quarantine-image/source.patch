+		{"POST", factory.PcfOamResUriPrefix + "/recovery-current", false}, {"GET", factory.PcfOamResUriPrefix + "/am-policy/test", false},
+		{"POST", "/npcf-smpolicycontrol/v1/sm-policies", false},
+		{"POST", "/npcf-am-policy-control/v1/policies", false},
+		{"POST", "/callbacks/test", false},
