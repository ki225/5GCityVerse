+func TestRecoveryQuarantineSkipsNRFRegistration(t *testing.T) {
+	ctx := &pcf_context.PCFContext{NfId: "before"}
+	boot := pcf_context.BootReceipt{PodUID: "12345678-1234-1234-1234-123456789abc",
+		BootEpoch: "test-epoch", PreListenerPoolsEmpty: true, PriorEpochState: "unknown"}
+	server := &Server{pcf: quarantineRoutePCF{ctx: ctx}}
+	calls := 0
+	register := func() (string, error) { calls++; return "registered", nil }
+	if err := ctx.EnableRecoveryQuarantine(boot); err != nil {
+		t.Fatal(err)
+	}
+	if err := server.registerWithNRF(register); err != nil {
+		t.Fatal(err)
+	}
+	if calls != 0 || ctx.NfId != "before" {
+		t.Fatal("recovery PCF registered with NRF")
+	}
+	other := &pcf_context.PCFContext{NfId: "before"}
+	server.pcf = quarantineRoutePCF{ctx: other}
+	if err := server.registerWithNRF(register); err != nil {
+		t.Fatal(err)
+	}
+	if calls != 1 || other.NfId != "registered" {
+		t.Fatal("default registration changed")
+	}
+}
+
+func TestRecoveryCurrentOAMLoopbackAndScope(t *testing.T) {
+	ctx := &pcf_context.PCFContext{}
