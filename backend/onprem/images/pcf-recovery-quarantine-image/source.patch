diff --git a/internal/context/boot_receipt.go b/internal/context/boot_receipt.go
new file mode 100644
index 0000000..4748bdb
--- /dev/null
+++ b/internal/context/boot_receipt.go
@@ -0,0 +1,100 @@
+package context
+
+import (
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/hex"
+	"errors"
+	"io"
+	"os"
+	"regexp"
+	"sync"
+	"time"
+)
+
+// BootReceipt describes only the state of this process before it starts its SBI
+// listener. It deliberately makes no claim about an earlier PCF incarnation or
+// policies that may remain in SMF or UPF.
+type BootReceipt struct {
+	SchemaVersion         int    `json:"schemaVersion"`
+	Source                string `json:"source"`
+	BootEpoch             string `json:"bootEpoch"`
+	ObservedAt            string `json:"observedAt"`
+	PodUID                string `json:"podUid"`
+	PID                   int    `json:"pid"`
+	BinarySHA256          string `json:"binarySha256"`
+	NfInstanceID          string `json:"nfInstanceId"`
+	PreListenerPoolsEmpty bool   `json:"preListenerPoolsEmpty"`
+	UECount               int    `json:"ueCount"`
+	AppSessionCount       int    `json:"appSessionCount"`
+	BdtPolicyCount        int    `json:"bdtPolicyCount"`
+	AMFStatusSubsCount    int    `json:"amfStatusSubsCount"`
+	PriorEpochState       string `json:"priorEpochState"`
+}
+
+var podUIDPattern = regexp.MustCompile(`^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$`)
+var bootReceiptLock sync.Mutex
+var bootReceipt *BootReceipt
+
+func newBootReceipt(c *PCFContext, podUID, binaryPath string) (BootReceipt, error) {
+	if c == nil || !podUIDPattern.MatchString(podUID) || c.NfId == "" {
+		return BootReceipt{}, errors.New("PCF boot identity unavailable")
+	}
+	// This function is called once by NewApp before NewServer and before any
+	// listener or NF registration. sync.Map.Range is safe here because there is
+	// no policy writer yet; it must never be reused for live inventory.
+	counts := [4]int{}
+	c.UePool.Range(func(_, _ any) bool { counts[0]++; return true })
+	c.AppSessionPool.Range(func(_, _ any) bool { counts[1]++; return true })
+	c.BdtPolicyPool.Range(func(_, _ any) bool { counts[2]++; return true })
+	c.AMFStatusSubsData.Range(func(_, _ any) bool { counts[3]++; return true })
+	if counts != [4]int{} {
+		return BootReceipt{}, errors.New("PCF active pool populated before listener")
+	}
+	file, err := os.Open(binaryPath)
+	if err != nil {
+		return BootReceipt{}, err
+	}
+	defer file.Close()
+	hash := sha256.New()
+	if _, err = io.Copy(hash, file); err != nil {
+		return BootReceipt{}, err
+	}
+	nonce := make([]byte, 16)
+	if _, err = rand.Read(nonce); err != nil {
+		return BootReceipt{}, err
+	}
+	return BootReceipt{
+		SchemaVersion: 1, Source: "pcf-process-pre-listener",
+		BootEpoch: hex.EncodeToString(nonce), ObservedAt: time.Now().UTC().Format(time.RFC3339Nano),
+		PodUID: podUID, PID: os.Getpid(), BinarySHA256: "sha256:" + hex.EncodeToString(hash.Sum(nil)),
+		NfInstanceID: c.NfId, PreListenerPoolsEmpty: true,
+		UECount: 0, AppSessionCount: 0, BdtPolicyCount: 0, AMFStatusSubsCount: 0,
+		PriorEpochState: "unknown",
+	}, nil
+}
+
+// CaptureBootReceipt is the only initialization path. Repeated calls fail
+// closed rather than replacing an epoch while this process may be serving.
+func CaptureBootReceipt(podUID string) (BootReceipt, error) {
+	bootReceiptLock.Lock()
+	defer bootReceiptLock.Unlock()
+	if bootReceipt != nil {
+		return BootReceipt{}, errors.New("PCF boot receipt already captured")
+	}
+	receipt, err := newBootReceipt(&pcfContext, podUID, "/proc/self/exe")
+	if err != nil {
+		return BootReceipt{}, err
+	}
+	bootReceipt = &receipt
+	return receipt, nil
+}
+
+func GetBootReceipt() (BootReceipt, bool) {
+	bootReceiptLock.Lock()
+	defer bootReceiptLock.Unlock()
+	if bootReceipt == nil {
+		return BootReceipt{}, false
+	}
+	return *bootReceipt, true
+}
diff --git a/internal/context/boot_receipt_test.go b/internal/context/boot_receipt_test.go
new file mode 100644
index 0000000..0bbe00f
--- /dev/null
+++ b/internal/context/boot_receipt_test.go
@@ -0,0 +1,73 @@
+package context
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+const testPodUID = "12345678-1234-1234-1234-123456789abc"
+
+func testBinary(t *testing.T) string {
+	t.Helper()
+	path := filepath.Join(t.TempDir(), "pcf")
+	if err := os.WriteFile(path, []byte("isolated-test-binary"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	return path
+}
+
+func TestBootReceiptEmptyBeforeListener(t *testing.T) {
+	c := &PCFContext{NfId: "pcf-test-instance"}
+	r, err := newBootReceipt(c, testPodUID, testBinary(t))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if r.SchemaVersion != 1 || r.Source != "pcf-process-pre-listener" ||
+		r.PodUID != testPodUID || r.NfInstanceID != c.NfId ||
+		!r.PreListenerPoolsEmpty || r.PriorEpochState != "unknown" ||
+		r.UECount != 0 || r.AppSessionCount != 0 || r.BdtPolicyCount != 0 || r.AMFStatusSubsCount != 0 ||
+		len(r.BootEpoch) != 32 || !strings.HasPrefix(r.BinarySHA256, "sha256:") ||
+		len(r.BinarySHA256) != 71 || r.PID <= 0 || r.ObservedAt == "" {
+		t.Fatalf("invalid boot receipt: %+v", r)
+	}
+	other, err := newBootReceipt(c, testPodUID, testBinary(t))
+	if err != nil || other.BootEpoch == r.BootEpoch {
+		t.Fatal("boot epoch must be unique")
+	}
+}
+
+func TestBootReceiptFailsClosedForPreExistingPolicy(t *testing.T) {
+	for _, pool := range []string{"ue", "app", "bdt", "amfStatus"} {
+		t.Run(pool, func(t *testing.T) {
+			c := &PCFContext{NfId: "pcf-test-instance"}
+			switch pool {
+			case "ue":
+				c.UePool.Store("imsi-test", struct{}{})
+			case "app":
+				c.AppSessionPool.Store("app-test", struct{}{})
+			case "bdt":
+				c.BdtPolicyPool.Store("bdt-test", struct{}{})
+			case "amfStatus":
+				c.AMFStatusSubsData.Store("subscription-test", struct{}{})
+			}
+			if _, err := newBootReceipt(c, testPodUID, testBinary(t)); err == nil {
+				t.Fatal("populated pool accepted")
+			}
+		})
+	}
+}
+
+func TestBootReceiptRequiresBoundIdentity(t *testing.T) {
+	c := &PCFContext{NfId: "pcf-test-instance"}
+	for _, uid := range []string{"", "not-a-pod-uid", "12345678-1234-1234-1234-123456789abz"} {
+		if _, err := newBootReceipt(c, uid, testBinary(t)); err == nil {
+			t.Fatal("unbound identity accepted")
+		}
+	}
+	c.NfId = ""
+	if _, err := newBootReceipt(c, testPodUID, testBinary(t)); err == nil {
+		t.Fatal("missing NF identity accepted")
+	}
+}
