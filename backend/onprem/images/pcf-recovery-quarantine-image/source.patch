+// The quarantine is installed before every SBI route. Only local OAM evidence
+// reads may reach a handler while recovery is active.
+func recoveryQuarantineMiddleware(ctx *pcf_context.PCFContext) gin.HandlerFunc {
+	return func(c *gin.Context) {
+		if ctx.RecoveryQuarantineEnabled() {
+			path := c.Request.URL.Path
+			allowed := c.Request.Method == http.MethodGet &&
+				(path == factory.PcfOamResUriPrefix+"/boot-receipt" ||
+					path == factory.PcfOamResUriPrefix+"/recovery-current")
+			if !allowed {
+				c.AbortWithStatus(http.StatusServiceUnavailable)
+				return
+			}
+		}
+		c.Next()
+	}
+}
