+	} {
+		r := httptest.NewRecorder()
+		request := httptest.NewRequest(http.MethodGet, factory.PcfOamResUriPrefix+"/recovery-current", nil)
+		request.RemoteAddr = tc.remote
+		c, _ := gin.CreateTestContext(r)
+		c.Request = request
+		server.HTTPOAMGetRecoveryCurrent(c)
+		c.Writer.WriteHeaderNow()
+		if r.Code != tc.status {
+			t.Fatalf("remote=%s status=%d", tc.remote, r.Code)
+		}
+		if tc.status == http.StatusOK {
+			var receipt pcf_context.RecoveryCurrentReceipt
+			if err := json.Unmarshal(r.Body.Bytes(), &receipt); err != nil {
