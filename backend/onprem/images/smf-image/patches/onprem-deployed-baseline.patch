+}
+
+func pfcpQERUpdateAccepted(upf *smf_context.UPF, smContext *smf_context.SMContext,
+	qer *smf_context.QER,
+) error {
+	rcvMsg, err := pfcp_message.SendPfcpSessionModificationRequest(
+		upf, smContext, nil, nil, nil, []*smf_context.QER{qer}, nil)
+	if err != nil {
+		return err
+	}
+	rsp, ok := rcvMsg.PfcpMessage.Body.(pfcp.PFCPSessionModificationResponse)
+	if !ok {
+		return fmt.Errorf("unexpected PFCP response body %T", rcvMsg.PfcpMessage.Body)
+	}
+	if rsp.Cause == nil {
+		return fmt.Errorf("PFCP Session Modification response has no cause")
+	}
+	if rsp.Cause.CauseValue != pfcpType.CauseRequestAccepted {
+		return fmt.Errorf("PFCP Session Modification rejected with cause %d", rsp.Cause.CauseValue)
+	}
+	pfcpContext := smContext.PFCPContext[upf.NodeID.ResolveNodeIdToIp().String()]
+	if pfcpContext != nil {
+		sst := int32(0)
+		sd := ""
+		if smContext.SNssai != nil {
+			sst = smContext.SNssai.Sst
+			sd = smContext.SNssai.Sd
+		}
+		// This line is consumed by the independent kernel/PFCP evidence reader.
+		// Repeat the generic SEID/TEID keys so its strict intersection check can
+		// match either direction without trusting an actuator-only identifier.
+		smContext.Log.Infof("PFCP Session Modification Request sent; PFCP Session Modification Response accepted SEID=%d SEID=%d TEID=0x%x TEID=0x%x QERID=%d SST=%d SD=%s DNN=%s UPF=%s ULMBRKbps=%d DLMBRKbps=%d",
+			pfcpContext.LocalSEID, pfcpContext.RemoteSEID, smContext.LocalULTeid, smContext.LocalDLTeid,
+			qer.QERID, sst, sd, smContext.Dnn, upf.NodeID.ResolveNodeIdToIp().String(), qer.MBR.ULMBR, qer.MBR.DLMBR)
+	}
+	return nil
+}
+
+func rollbackQERs(smContext *smf_context.SMContext, updates []qerRollback) bool {
+	rollbackOK := true
+	for i := len(updates) - 1; i >= 0; i-- {
+		update := updates[i]
+		update.qer.MBR = update.previous
+		update.qer.State = smf_context.RULE_UPDATE
+		if err := pfcpQERUpdateAccepted(update.upf, smContext, update.qer); err != nil {
+			rollbackOK = false
+		}
+	}
+	return rollbackOK
+}
+
+func actuateSMContextQER(smContext *smf_context.SMContext, supi string, dnn string, sst int32, sd string,
+	uplinkMBRKbps, downlinkMBRKbps uint64,
+) qerActuationResult {
+	result := qerActuationResult{SMContextRef: smContext.Ref, Status: "failed"}
+	smContext.SMLock.Lock()
+	defer smContext.SMLock.Unlock()
+
+	if smf_context.GetSMContextByRef(smContext.Ref) != smContext {
+		result.Error = "SM context is no longer active"
+		return result
+	}
+	if smContext.Supi != supi {
+		result.Status = "skipped"
+		return result
+	}
+	result.DNN = smContext.Dnn
+	if smContext.SNssai != nil {
+		result.SST = smContext.SNssai.Sst
+		result.SD = smContext.SNssai.Sd
+	}
+	if dnn != "" && smContext.Dnn != dnn {
+		result.Status = "skipped"
+		return result
+	}
+	if sst != 0 && (smContext.SNssai == nil || smContext.SNssai.Sst != sst || smContext.SNssai.Sd != sd) {
+		result.Status = "skipped"
+		return result
+	}
+	if smContext.State() != smf_context.Active {
+		result.Error = fmt.Sprintf("SM context state is %s", smContext.State())
+		return result
+	}
+
+	updates := make([]qerRollback, 0, len(smContext.AMBRQerMap))
+	seen := make(map[string]struct{})
+	for upfID, qerID := range smContext.AMBRQerMap {
+		qerKey := fmt.Sprintf("%s:%d", upfID.String(), qerID)
+		if _, duplicate := seen[qerKey]; duplicate {
+			continue
+		}
+		seen[qerKey] = struct{}{}
+		upf := smf_context.GetUpfById(upfID.String())
+		if upf == nil {
+			result.Error = fmt.Sprintf("UPF %s is unavailable", upfID.String())
+			rollbackQERs(smContext, updates)
+			return result
+		}
+		nodeIP := upf.NodeID.ResolveNodeIdToIp().String()
+		pfcpContext, ok := smContext.PFCPContext[nodeIP]
+		if !ok || pfcpContext.RemoteSEID == 0 {
+			result.Error = fmt.Sprintf("PFCP session for UPF %s is not established", nodeIP)
+			rollbackQERs(smContext, updates)
+			return result
+		}
+		qer := upf.GetQERById(qerID)
+		if qer == nil || qer.MBR == nil {
+			result.Error = fmt.Sprintf("AMBR QER %d is unavailable", qerID)
+			rollbackQERs(smContext, updates)
+			return result
+		}
+		previous := *qer.MBR
+		updates = append(updates, qerRollback{upf: upf, qer: qer, previous: &previous})
+		qer.MBR = &pfcpType.MBR{ULMBR: uplinkMBRKbps, DLMBR: downlinkMBRKbps}
+		qer.State = smf_context.RULE_UPDATE
+		if err := pfcpQERUpdateAccepted(upf, smContext, qer); err != nil {
+			result.Error = err.Error()
+			if rollbackQERs(smContext, updates) {
+				result.Status = "rolled_back"
+			} else {
+				result.Status = "indeterminate"
+				result.ReconciliationNeeded = true
+			}
+			return result
+		}
+		result.UpdatedQERs++
+	}
+	if result.UpdatedQERs == 0 {
+		result.Error = "no established AMBR QER was found"
+		return result
+	}
+	result.Status = "applied"
+	return result
+}
+
+func (p *Processor) HandleOAMQERActuation(c *gin.Context, supi string, uplinkMBRKbps, downlinkMBRKbps uint64) {
+	contexts := make([]*smf_context.SMContext, 0)
+	smf_context.VisitSMContextSnapshot(func(smContext *smf_context.SMContext) {
+		if smContext.Supi == supi {
+			contexts = append(contexts, smContext)
+		}
+	})
+	if len(contexts) == 0 {
+		c.JSON(http.StatusNotFound, gin.H{"error": "no matching SM context"})
+		return
+	}
+
+	results := make([]qerActuationResult, 0, len(contexts))
+	matched := 0
+	applied := 0
+	for _, smContext := range contexts {
+		result := actuateSMContextQER(smContext, supi, "", 0, "", uplinkMBRKbps, downlinkMBRKbps)
+		if result.Status == "skipped" {
+			continue
+		}
+		matched++
+		if result.Status == "applied" {
+			applied++
+		}
+		results = append(results, result)
+	}
+	if matched == 0 {
+		c.JSON(http.StatusNotFound, gin.H{"error": "no matching active SM context"})
+		return
+	}
+	statusCode := http.StatusOK
+	if applied == 0 {
+		statusCode = http.StatusBadGateway
+	} else if applied != matched {
+		statusCode = http.StatusMultiStatus
+	}
+	c.JSON(statusCode, gin.H{
+		"matchedSessions": matched,
+		"appliedSessions": applied,
+		"uplinkMbrKbps":   uplinkMBRKbps,
+		"downlinkMbrKbps": downlinkMBRKbps,
+		"results":         results,
+	})
+}
