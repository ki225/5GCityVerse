+
+func qerActuatorAuthorized(c *gin.Context) (bool, int, string) {
+	tokenFile := strings.TrimSpace(os.Getenv("SMF_QER_ACTUATOR_TOKEN_FILE"))
+	if tokenFile == "" {
+		return false, http.StatusServiceUnavailable, "actuator token is not configured"
+	}
+	expectedBytes, err := os.ReadFile(tokenFile)
+	if err != nil || strings.TrimSpace(string(expectedBytes)) == "" {
+		return false, http.StatusServiceUnavailable, "actuator token is unavailable"
+	}
+	expected := []byte(strings.TrimSpace(string(expectedBytes)))
+	provided := []byte(c.GetHeader("X-SMF-QER-Actuator-Token"))
+	if len(expected) != len(provided) || subtle.ConstantTimeCompare(expected, provided) != 1 {
+		return false, http.StatusUnauthorized, "unauthorized"
+	}
+	return true, http.StatusOK, ""
+}
+
+func (s *Server) HTTPActuateQER(c *gin.Context) {
+	if ok, status, message := qerActuatorAuthorized(c); !ok {
+		c.JSON(status, gin.H{"error": message})
+		return
+	}
+	var request qerActuationRequest
+	if err := c.ShouldBindJSON(&request); err != nil {
+		c.JSON(http.StatusBadRequest, gin.H{"error": "invalid JSON body"})
+		return
+	}
+	request.SMContextRef = strings.TrimSpace(request.SMContextRef)
+	request.SUPI = strings.TrimSpace(request.SUPI)
+	request.DNN = strings.TrimSpace(request.DNN)
+	request.SD = strings.TrimSpace(request.SD)
+	if request.SMContextRef != "" || request.DNN != "" || request.SST != 0 || request.SD != "" || request.SUPI == "" {
+		c.JSON(http.StatusBadRequest, gin.H{"error": "an exact SUPI selector is required"})
+		return
+	}
+	const maxMBRKbps = uint64(500000)
+	if request.UplinkMBRKbps == 0 || request.DownlinkMBRKbps == 0 ||
+		request.UplinkMBRKbps > maxMBRKbps || request.DownlinkMBRKbps > maxMBRKbps {
+		c.JSON(http.StatusBadRequest, gin.H{"error": "MBR must be between 1 and 500000 Kbps"})
+		return
+	}
+	s.Processor().HandleOAMQERActuation(c, request.SUPI, request.UplinkMBRKbps, request.DownlinkMBRKbps)
 }
 
