+
+func TestQERActuatorRequiresTokenAndExactSUPI(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	server := &Server{}
+	request := func(body, token string) int {
+		recorder := httptest.NewRecorder()
+		context, _ := gin.CreateTestContext(recorder)
+		context.Request = httptest.NewRequest(http.MethodPost, "/nsmf-oam/v1/qer-actuation", strings.NewReader(body))
+		context.Request.Header.Set("Content-Type", "application/json")
+		context.Request.Header.Set("X-SMF-QER-Actuator-Token", token)
+		server.HTTPActuateQER(context)
+		return recorder.Code
+	}
+	validRates := `"uplinkMbrKbps":1000,"downlinkMbrKbps":1000`
+	t.Setenv("SMF_QER_ACTUATOR_TOKEN_FILE", "")
+	require.Equal(t, http.StatusServiceUnavailable, request(`{"supi":"imsi-208930100000001",`+validRates+`}`, "secret"))
+
+	secret := t.TempDir() + "/token"
+	require.NoError(t, os.WriteFile(secret, []byte("secret"), 0600))
+	t.Setenv("SMF_QER_ACTUATOR_TOKEN_FILE", secret)
+	require.Equal(t, http.StatusUnauthorized, request(`{"supi":"imsi-208930100000001",`+validRates+`}`, "wrong"))
+	require.Equal(t, http.StatusBadRequest, request(`{"dnn":"internet",`+validRates+`}`, "secret"))
+	require.Equal(t, http.StatusBadRequest, request(`{"smContextRef":"ref","supi":"imsi-208930100000001",`+validRates+`}`, "secret"))
+	require.Equal(t, http.StatusBadRequest, request(`{"supi":"imsi-208930100000001","uplinkMbrKbps":0,"downlinkMbrKbps":1000}`, "secret"))
+}
