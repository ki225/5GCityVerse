+func TestIntentUPFViewNeverHoldsTopologyLockWhileWaitingForSession(t *testing.T) {
+	exerciseIntentCensusLockOrder(t, false)
+}
+
+func TestIntentUPFUnregisterNeverHoldsTopologyLockWhileWaitingForSession(t *testing.T) {
+	exerciseIntentCensusLockOrder(t, true)
+}
+
+func exerciseIntentCensusLockOrder(t *testing.T, remove bool) {
+	dir := t.TempDir()
+	if err := os.Chmod(dir, 0700); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("SMF_SESSION_QER_STATE_DIR", dir)
+	t.Setenv("SMF_SESSION_QER_NETWORK_SCOPE", "city")
+	old := smf_context.GetSelf().UserPlaneInformation
+	defer func() { smf_context.GetSelf().UserPlaneInformation = old }()
+	id := pfcpType.NodeID{NodeIdType: pfcpType.NodeIdTypeIpv4Address, IP: net.ParseIP("198.18.0.1").To4()}
+	node := &smf_context.UPNode{Name: "lock-test", NodeID: id, UPF: smf_context.NewUPF(&id, nil)}
+	upi := &smf_context.UserPlaneInformation{UPFs: map[string]*smf_context.UPNode{"lock-test": node}}
+	smf_context.GetSelf().UserPlaneInformation = upi
+	oldTEID := smf_context.TeidGenerator
+	smf_context.TeidGenerator = idgenerator.NewGenerator(1, 1000)
+	defer func() { smf_context.TeidGenerator = oldTEID }()
+	sm := smf_context.NewSMContext("imsi-001010000000098", 1)
+	sm.SmfPduSessionSmContextCreateData = &models.SmfPduSessionSmContextCreateData{Supi: "imsi-001010000000098"}
+	defer smf_context.RemoveSMContext(sm.Ref)
+	state := smf_context.IntentUPFState{Target: "lock-test", Owner: "intent", Operation: "operation", Managed: true, Accepting: false, Revision: 1}
+	smf_context.IntentControlMu.Lock()
+	err := smf_context.IntentSaveUPFStateLocked(state)
+	smf_context.IntentControlMu.Unlock()
+	if err != nil {
+		t.Fatal(err)
+	}
+	sm.SMLock.Lock()
+	done := make(chan error, 1)
+	go func() {
+		if !remove {
+			_, err := intentUPFView("lock-test")
+			done <- err
+			return
+		}
+		body, _ := json.Marshal(intentUPFCommand{Target: "lock-test", Owner: "intent", Operation: "operation", Expected: smf_context.IntentUPFVersion(state, node.UPF.UUID())})
+		out := httptest.NewRecorder()
+		c, _ := gin.CreateTestContext(out)
+		c.Request = httptest.NewRequest("POST", "/upf-control/unregister", bytes.NewReader(body))
+		(&Processor{}).HandleIntentUPFUnregister(c)
+		if out.Code != 200 {
+			done <- fmt.Errorf("unregister status %d: %s", out.Code, out.Body.String())
+		} else {
+			done <- nil
+		}
+	}()
+	// The reader must release topology before blocking on the already-held session.
+	time.Sleep(25 * time.Millisecond)
+	writer := make(chan struct{})
+	go func() { upi.Mu.Lock(); upi.Mu.Unlock(); close(writer) }()
+	select {
+	case <-writer:
+	case <-time.After(time.Second):
+		sm.SMLock.Unlock()
+		<-writer
+		<-done
+		t.Fatal("topology writer blocked behind reader waiting for session lock")
+	}
+	// Match the production create order: session lock, then topology lock.
+	upi.Mu.RLock()
+	upi.Mu.RUnlock()
+	sm.SMLock.Unlock()
+	select {
+	case err := <-done:
+		if err != nil {
+			t.Fatal(err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("native census deadlocked")
+	}
+}
