diff --git a/internal/context/intent_control.go b/internal/context/intent_control.go
new file mode 100644
index 0000000..b9c4eeb
--- /dev/null
+++ b/internal/context/intent_control.go
@@ -0,0 +1,405 @@
+package context
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net"
+	"os"
+	"path/filepath"
+	"regexp"
+	"sort"
+	"sync"
+	"time"
+
+	"github.com/free5gc/smf/pkg/factory"
+	"github.com/google/uuid"
+)
+
+var IntentControlMu sync.Mutex
+var IntentBootEpoch = uuid.NewString()
+
+// ErrIntentAdmissionAbsent is produced only for a missing record in an existing, verified store.
+var ErrIntentAdmissionAbsent = errors.New("intent admission record absent")
+var intentNonce = regexp.MustCompile(`^[A-Za-z0-9_-]{1,128}$`)
+
+type IntentUPFState struct {
+	Target    string `json:"target_id"`
+	Owner     string `json:"owner_id"`
+	Operation string `json:"operation_id"`
+	Accepting bool   `json:"accepting"`
+	Managed   bool   `json:"managed"`
+	Removed   bool   `json:"removed"`
+	Revision  uint64 `json:"revision"`
+}
+
+func IntentUPFRegistrationOwnerAllowed(state IntentUPFState, owner, expected string) bool {
+	return state.Owner == "" || state.Owner == owner ||
+		(state.Managed && state.Removed && !state.Accepting && expected == IntentUPFVersion(state, ""))
+}
+
+type IntentAdmission struct {
+	Scope               string                `json:"network_scope"`
+	SUPI                string                `json:"supi"`
+	SessionID           int32                 `json:"pdu_session_id"`
+	Nonce               string                `json:"nonce"`
+	Owner               string                `json:"owner_id"`
+	Operation           string                `json:"operation_id"`
+	TargetUPF           string                `json:"target_upf_id"`
+	ValidFrom           float64               `json:"valid_from"`
+	ValidUntil          float64               `json:"valid_until"`
+	RegisteredAt        float64               `json:"registered_at"`
+	BootEpoch           string                `json:"boot_epoch"`
+	Status              string                `json:"status"`
+	Revision            uint64                `json:"revision"`
+	InstallationVersion string                `json:"installation_version"`
+	Binding             *IntentSessionBinding `json:"binding,omitempty"`
+}
+type IntentSessionBinding struct {
+	Ref                 string  `json:"smContextRef"`
+	Epoch               string  `json:"establishedEpoch"`
+	Key                 string  `json:"session_key"`
+	CreatedAt           float64 `json:"created_at"`
+	UPFID               string  `json:"upf_id"`
+	NodeIP              string  `json:"upf_node_ip"`
+	InstallationVersion string  `json:"installation_version"`
+}
+
+func IntentDigest(value interface{}) string {
+	raw, _ := json.Marshal(value)
+	hash := sha256.Sum256(raw)
+	return hex.EncodeToString(hash[:])
+}
+func IntentStateDir() (string, error) {
+	root := os.Getenv("SMF_SESSION_QER_STATE_DIR")
+	if !filepath.IsAbs(root) {
+		return "", errors.New("persistent intent state not configured")
+	}
+	root = filepath.Join(root, "selection")
+	if err := os.MkdirAll(root, 0700); err != nil {
+		return "", err
+	}
+	s, err := os.Lstat(root)
+	if err != nil || !s.IsDir() || s.Mode()&os.ModeSymlink != 0 || s.Mode().Perm()&0077 != 0 {
+		return "", errors.New("invalid intent state directory")
+	}
+	return root, nil
+}
+func intentRead(kind, key string, value interface{}) error {
+	dir, err := IntentStateDir()
+	if err != nil {
+		return err
+	}
+	p := filepath.Join(dir, kind+"-"+IntentDigest(key)+".json")
+	s, err := os.Lstat(p)
+	if err != nil {
+		return err
+	}
+	if !s.Mode().IsRegular() || s.Size() > 32768 {
+		return errors.New("invalid intent record")
+	}
+	raw, err := os.ReadFile(p)
+	if err != nil {
+		return err
+	}
+	return json.Unmarshal(raw, value)
+}
+func intentSave(kind, key string, value interface{}) error {
+	dir, err := IntentStateDir()
+	if err != nil {
+		return err
+	}
+	raw, err := json.Marshal(value)
+	if err != nil || len(raw) > 32768 {
+		return errors.New("intent record exceeds bound")
+	}
+	f, err := os.CreateTemp(dir, ".intent-")
+	if err != nil {
+		return err
+	}
+	name := f.Name()
+	defer os.Remove(name)
+	if err = f.Chmod(0600); err == nil {
+		_, err = f.Write(raw)
+	}
+	if err == nil {
+		err = f.Sync()
+	}
+	closeErr := f.Close()
+	if err == nil {
+		err = closeErr
+	}
+	if err != nil {
+		return err
+	}
+	if err = os.Rename(name, filepath.Join(dir, kind+"-"+IntentDigest(key)+".json")); err != nil {
+		return err
+	}
+	d, err := os.Open(dir)
+	if err != nil {
+		return err
+	}
+	defer d.Close()
+	return d.Sync()
+}
+func IntentUPFStateLocked(target string) (IntentUPFState, error) {
+	s := IntentUPFState{Target: target, Accepting: true}
+	err := intentRead("upf", target, &s)
+	if os.IsNotExist(err) {
+		return s, nil
+	}
+	if err != nil || s.Target != target {
+		return s, errors.New("UPF intent state invalid")
+	}
+	return s, nil
+}
+func IntentSaveUPFStateLocked(s IntentUPFState) error { return intentSave("upf", s.Target, s) }
+func IntentUPFVersion(s IntentUPFState, upfID string) string {
+	return IntentDigest(struct {
+		State IntentUPFState
+		UPFID string
+		Boot  string
+	}{s, upfID, IntentBootEpoch})
+}
+func admissionIdentity(scope, supi string, id int32) string {
+	return fmt.Sprintf("%s|%s|%d", scope, supi, id)
+}
+func IntentAdmissionVersion(a IntentAdmission) string {
+	a.InstallationVersion = ""
+	return IntentDigest(a)
+}
+func IntentLoadAdmissionLocked(nonce string) (IntentAdmission, error) {
+	a := IntentAdmission{}
+	if !intentNonce.MatchString(nonce) {
+		return a, errors.New("invalid admission nonce")
+	}
+	// GET must not create a missing store or confuse storage failure with absence.
+	root := os.Getenv("SMF_SESSION_QER_STATE_DIR")
+	if !filepath.IsAbs(root) {
+		return a, errors.New("persistent intent state not configured")
+	}
+	parent, err := os.Lstat(root)
+	if err != nil || !parent.IsDir() || parent.Mode()&os.ModeSymlink != 0 || parent.Mode().Perm()&0500 != 0500 {
+		return a, errors.New("intent state root unavailable")
+	}
+	dir := filepath.Join(root, "selection")
+	before, err := os.Lstat(dir)
+	if err != nil || !before.IsDir() || before.Mode()&os.ModeSymlink != 0 || before.Mode().Perm() != 0700 {
+		return a, errors.New("intent selection store unavailable")
+	}
+	path := filepath.Join(dir, "admission-"+IntentDigest(nonce)+".json")
+	file, err := os.Lstat(path)
+	if os.IsNotExist(err) {
+		after, statErr := os.Lstat(dir)
+		if statErr == nil && after.IsDir() && after.Mode().Perm() == 0700 && os.SameFile(before, after) {
+			return a, ErrIntentAdmissionAbsent
+		}
+		return a, errors.New("intent selection store changed")
+	}
+	if err != nil {
+		return a, err
+	}
+	if !file.Mode().IsRegular() || file.Size() > 32768 || file.Mode().Perm()&0400 == 0 {
+		return a, errors.New("invalid intent admission record")
+	}
+	raw, err := os.ReadFile(path)
+	if err != nil {
+		return a, err
+	}
+	err = json.Unmarshal(raw, &a)
+	if err != nil {
+		return a, err
+	}
+	if a.Nonce != nonce {
+		return a, errors.New("admission not found")
+	}
+	return a, nil
+}
+func IntentSaveAdmissionLocked(a IntentAdmission) error { return intentSave("admission", a.Nonce, a) }
+func IntentRegisterAdmissionLocked(a IntentAdmission, expected string) (IntentAdmission, error) {
+	if a.Scope == "" || a.Scope != os.Getenv("SMF_SESSION_QER_NETWORK_SCOPE") || !intentNonce.MatchString(a.Nonce) || a.SUPI == "" || a.SessionID < 1 || a.SessionID > 15 || a.Owner == "" || a.Operation == "" || a.TargetUPF == "" {
+		return a, errors.New("invalid admission identity")
+	}
+	now := float64(time.Now().UnixNano()) / 1e9
+	if !(a.ValidFrom <= now && now < a.ValidUntil && a.ValidUntil-now <= 3600) {
+		return a, errors.New("admission validity outside one hour")
+	}
+	if existing := GetSMContextById(a.SUPI, a.SessionID); existing != nil {
+		return a, errors.New("existing PDU session cannot be migrated by admission")
+	}
+	if _, err := IntentStateDir(); err != nil {
+		return a, err
+	}
+	current, err := IntentLoadAdmissionLocked(a.Nonce)
+	if err == nil {
+		if (expected != "absent" && expected != IntentAdmissionVersion(current)) || current.Owner != a.Owner || current.Operation != a.Operation || current.Status != "registered" || current.Scope != a.Scope || current.SUPI != a.SUPI || current.SessionID != a.SessionID || current.TargetUPF != a.TargetUPF || current.ValidFrom != a.ValidFrom || current.ValidUntil != a.ValidUntil {
+			return a, errors.New("admission owner or version conflict")
+		}
+		return current, nil
+	} else if !errors.Is(err, ErrIntentAdmissionAbsent) || expected != "absent" {
+		return a, errors.New("admission version conflict")
+	}
+	var previous string
+	index := admissionIdentity(a.Scope, a.SUPI, a.SessionID)
+	indexErr := intentRead("admission-index", index, &previous)
+	if indexErr != nil && !os.IsNotExist(indexErr) {
+		return a, indexErr
+	}
+	if indexErr == nil && previous != a.Nonce {
+		old, readErr := IntentLoadAdmissionLocked(previous)
+		if readErr != nil || (old.Status != "cancelled" && now < old.ValidUntil) {
+			return a, errors.New("another admission owns this future session")
+		}
+	}
+	a.RegisteredAt = now
+	a.BootEpoch = IntentBootEpoch
+	a.Status = "registered"
+	a.Revision = current.Revision + 1
+	a.Binding = nil
+	a.InstallationVersion = IntentAdmissionVersion(a)
+	if err := IntentSaveAdmissionLocked(a); err != nil {
+		return a, err
+	}
+	if err := intentSave("admission-index", index, a.Nonce); err != nil {
+		return a, err
+	}
+	return a, nil
+}
+
+func ValidateIntentUPFTemplate(upi *UserPlaneInformation, node *factory.UPNode, links []string) error {
+	if node == nil || node.Type != "UPF" || net.ParseIP(node.NodeID) == nil || (node.Addr != "" && net.ParseIP(node.Addr) == nil) || len(node.SNssaiInfos) == 0 || len(links) == 0 {
+		return errors.New("invalid pinned UPF template")
+	}
+	for _, name := range links {
+		if upi.AccessNetwork[name] == nil {
+			return errors.New("UPF link must reference an existing access network")
+		}
+	}
+	nets := []*net.IPNet{}
+	for _, up := range upi.UPFs {
+		for _, slice := range up.UPF.SNssaiInfos {
+			for _, dnn := range slice.DnnList {
+				for _, pool := range dnn.UeIPPools {
+					nets = append(nets, pool.ueSubNet)
+				}
+			}
+		}
+	}
+	for _, slice := range node.SNssaiInfos {
+		if slice == nil || slice.SNssai == nil || len(slice.DnnUpfInfoList) == 0 {
+			return errors.New("incomplete pinned slice capabilities")
+		}
+		for _, dnn := range slice.DnnUpfInfoList {
+			if dnn == nil || len(dnn.Pools) == 0 || len(dnn.StaticPools) != 0 {
+				return errors.New("dynamic UPF requires explicit dynamic-only address pools")
+			}
+			for _, pool := range dnn.Pools {
+				if pool == nil {
+					return errors.New("missing address pool")
+				}
+				_, network, err := net.ParseCIDR(pool.Cidr)
+				if err != nil || network.IP.To4() == nil {
+					return errors.New("valid IPv4 pool required")
+				}
+				ones, bits := network.Mask.Size()
+				if bits != 32 || ones > 30 {
+					return errors.New("address pool too small")
+				}
+				for _, old := range nets {
+					if old.Contains(network.IP) || network.Contains(old.IP) {
+						return errors.New("new UPF address pool overlaps existing capacity")
+					}
+				}
+				nets = append(nets, network)
+			}
+		}
+		if valid, err := slice.Validate(); err != nil || !valid {
+			return errors.New("invalid pinned slice capabilities")
+		}
+	}
+	return nil
+}
+
+// Caller already holds UserPlaneInformation.Mu and the creating session's SMLock.
+func BeginIntentUPFSelection(sm *SMContext, candidates []*UPNode) ([]*UPNode, func(*UPNode) error, func(), error) {
+	if os.Getenv("SMF_SESSION_QER_STATE_DIR") == "" {
+		return candidates, func(*UPNode) error { return nil }, func() {}, nil
+	}
+	IntentControlMu.Lock()
+	release := func() { IntentControlMu.Unlock() }
+	var admission *IntentAdmission
+	if sm != nil {
+		var nonce string
+		err := intentRead("admission-index", admissionIdentity(os.Getenv("SMF_SESSION_QER_NETWORK_SCOPE"), sm.Supi, sm.PDUSessionID), &nonce)
+		if err == nil {
+			a, e := IntentLoadAdmissionLocked(nonce)
+			if e != nil {
+				release()
+				return nil, nil, nil, e
+			}
+			now := float64(time.Now().UnixNano()) / 1e9
+			if a.Status != "cancelled" && now < a.ValidUntil {
+				if a.BootEpoch != IntentBootEpoch || now < a.ValidFrom || sm.IntentCreatedAt < a.RegisteredAt || a.Binding != nil {
+					release()
+					return nil, nil, nil, errors.New("admission creation fence changed")
+				}
+				admission = &a
+			}
+		} else if !os.IsNotExist(err) {
+			release()
+			return nil, nil, nil, err
+		}
+	}
+	selected := make([]*UPNode, 0)
+	for _, node := range candidates {
+		state, err := IntentUPFStateLocked(node.Name)
+		if err != nil {
+			release()
+			return nil, nil, nil, err
+		}
+		if state.Accepting && (admission == nil || node.UPF.UUID() == admission.TargetUPF) {
+			selected = append(selected, node)
+		}
+	}
+	if admission != nil && len(selected) != 1 {
+		release()
+		return nil, nil, nil, errors.New("admitted UPF is not an eligible accepting candidate")
+	}
+	bind := func(node *UPNode) error {
+		if admission == nil {
+			return nil
+		}
+		a := *admission
+		a.Binding = &IntentSessionBinding{Ref: sm.Ref, Epoch: sm.Ref, CreatedAt: sm.IntentCreatedAt, UPFID: node.UPF.UUID(), NodeIP: node.NodeID.ResolveNodeIdToIp().String(), InstallationVersion: a.InstallationVersion}
+		raw, _ := json.Marshal([]interface{}{a.Scope, sm.Supi, sm.PDUSessionID, sm.Ref})
+		a.Binding.Key = string(raw)
+		a.Status = "selected"
+		a.Revision++
+		return IntentSaveAdmissionLocked(a)
+	}
+	return selected, bind, release, nil
+}
+
+func IntentUPFSessions(node *UPNode) ([]string, []string, []string) {
+	active, inflight, seids := []string{}, []string{}, []string{}
+	for _, sm := range SMContextSnapshot() {
+		sm.SMLock.Lock()
+		ctx := sm.PFCPContext[node.NodeID.ResolveNodeIdToIp().String()]
+		selected := sm.SelectedUPF == node
+		raw, _ := json.Marshal([]interface{}{os.Getenv("SMF_SESSION_QER_NETWORK_SCOPE"), sm.Supi, sm.PDUSessionID, sm.Ref})
+		key := string(raw)
+		if ctx != nil && ctx.RemoteSEID != 0 {
+			active = append(active, key)
+			seids = append(seids, fmt.Sprint(ctx.RemoteSEID))
+		} else if selected || ctx != nil {
+			inflight = append(inflight, key)
+		}
+		sm.SMLock.Unlock()
+	}
+	sort.Strings(active)
+	sort.Strings(inflight)
+	sort.Strings(seids)
+	return active, seids, inflight
+}
diff --git a/internal/context/intent_control_test.go b/internal/context/intent_control_test.go
new file mode 100644
index 0000000..55a1eae
--- /dev/null
+++ b/internal/context/intent_control_test.go
@@ -0,0 +1,146 @@
+package context
+
+import (
+	"net"
+	"os"
+	"testing"
+	"time"
+
+	"github.com/free5gc/openapi/models"
+	"github.com/free5gc/pfcp/pfcpType"
+)
+
+func TestIntentRemovedUPFTargetCanBeReclaimedOnlyWithFreshTombstoneCAS(t *testing.T) {
+	state := IntentUPFState{Target: "reusable", Owner: "old-owner", Operation: "old-op", Managed: true, Removed: true, Revision: 3}
+	fresh := IntentUPFVersion(state, "")
+	if !IntentUPFRegistrationOwnerAllowed(state, "next-owner", fresh) {
+		t.Fatal("clean removed target cannot be reused")
+	}
+	if IntentUPFRegistrationOwnerAllowed(state, "next-owner", "absent") {
+		t.Fatal("old tombstone overwritten without fresh CAS")
+	}
+	state.Removed = false
+	if IntentUPFRegistrationOwnerAllowed(state, "next-owner", IntentUPFVersion(state, "")) {
+		t.Fatal("unresolved ownership transferred")
+	}
+	state.Removed = true
+	state.Accepting = true
+	if IntentUPFRegistrationOwnerAllowed(state, "next-owner", IntentUPFVersion(state, "")) {
+		t.Fatal("accepting target ownership transferred")
+	}
+}
+
+func intentFixture(t *testing.T) (*UPNode, *UPNode, IntentAdmission) {
+	t.Helper()
+	dir := t.TempDir()
+	if err := os.Chmod(dir, 0700); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("SMF_SESSION_QER_STATE_DIR", dir)
+	t.Setenv("SMF_SESSION_QER_NETWORK_SCOPE", "city")
+	nodes := []*UPNode{}
+	for _, ip := range []string{"198.18.1.10", "198.18.1.11"} {
+		id := pfcpType.NodeID{NodeIdType: pfcpType.NodeIdTypeIpv4Address, IP: net.ParseIP(ip).To4()}
+		nodes = append(nodes, &UPNode{Name: ip, NodeID: id, Type: UPNODE_UPF, UPF: NewUPF(&id, nil)})
+	}
+	now := float64(time.Now().UnixNano()) / 1e9
+	a := IntentAdmission{Scope: "city", SUPI: "imsi-001010000000007", SessionID: 1, Nonce: "nonce-1", Owner: "intent-owner", Operation: "operation", TargetUPF: nodes[0].UPF.UUID(), ValidFrom: now - 1, ValidUntil: now + 60}
+	return nodes[0], nodes[1], a
+}
+
+func TestIntentAdmissionExactNewSessionAndNoFallback(t *testing.T) {
+	first, other, a := intentFixture(t)
+	IntentControlMu.Lock()
+	saved, err := IntentRegisterAdmissionLocked(a, "absent")
+	IntentControlMu.Unlock()
+	if err != nil {
+		t.Fatal(err)
+	}
+	sm := &SMContext{Ref: "new-native-ref", PDUSessionID: 1, SmfPduSessionSmContextCreateData: &models.SmfPduSessionSmContextCreateData{Supi: a.SUPI}, IntentCreatedAt: float64(time.Now().UnixNano()) / 1e9}
+	filtered, bind, release, err := BeginIntentUPFSelection(sm, []*UPNode{other, first})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(filtered) != 1 || filtered[0] != first {
+		release()
+		t.Fatal("wrong UPF selected")
+	}
+	if err = bind(first); err != nil {
+		release()
+		t.Fatal(err)
+	}
+	release()
+	IntentControlMu.Lock()
+	current, err := IntentLoadAdmissionLocked(a.Nonce)
+	IntentControlMu.Unlock()
+	if err != nil || current.Status != "selected" || current.Binding.Ref != sm.Ref || current.Binding.UPFID != a.TargetUPF || current.InstallationVersion != saved.InstallationVersion {
+		t.Fatal("native creation identity not recorded")
+	}
+	sm.Ref = "another-ref"
+	if _, _, _, err = BeginIntentUPFSelection(sm, []*UPNode{first, other}); err == nil {
+		t.Fatal("consumed admission was reused")
+	}
+}
+
+func TestIntentAdmissionsRejectOverlapButAllowSameUEOtherPDU(t *testing.T) {
+	_, _, a := intentFixture(t)
+	IntentControlMu.Lock()
+	defer IntentControlMu.Unlock()
+	saved, err := IntentRegisterAdmissionLocked(a, "absent")
+	if err != nil {
+		t.Fatal(err)
+	}
+	again, err := IntentRegisterAdmissionLocked(a, "absent")
+	if err != nil || again.InstallationVersion != saved.InstallationVersion {
+		t.Fatal("exact retry was not idempotent")
+	}
+	a.Nonce = "nonce-2"
+	if _, err = IntentRegisterAdmissionLocked(a, "absent"); err == nil {
+		t.Fatal("overlapping admission accepted")
+	}
+	a.SessionID = 2
+	if _, err = IntentRegisterAdmissionLocked(a, "absent"); err != nil {
+		t.Fatal("same UE different PDU rejected", err)
+	}
+}
+
+func TestIntentDrainingTargetIsExcludedAndOldCreationRejected(t *testing.T) {
+	first, other, a := intentFixture(t)
+	IntentControlMu.Lock()
+	_, err := IntentRegisterAdmissionLocked(a, "absent")
+	if err == nil {
+		err = IntentSaveUPFStateLocked(IntentUPFState{Target: first.Name, Owner: a.Owner, Operation: a.Operation, Accepting: false, Managed: true, Revision: 1})
+	}
+	IntentControlMu.Unlock()
+	if err != nil {
+		t.Fatal(err)
+	}
+	sm := &SMContext{Ref: "new-native-ref", PDUSessionID: 1, SmfPduSessionSmContextCreateData: &models.SmfPduSessionSmContextCreateData{Supi: a.SUPI}, IntentCreatedAt: float64(time.Now().UnixNano()) / 1e9}
+	if _, _, _, err = BeginIntentUPFSelection(sm, []*UPNode{first, other}); err == nil {
+		t.Fatal("draining target fell back to another UPF")
+	}
+	sm.PDUSessionID = 2
+	selected, _, release, err := BeginIntentUPFSelection(sm, []*UPNode{first, other})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer release()
+	if len(selected) != 1 || selected[0] != other {
+		t.Fatal("draining target admitted ordinary traffic")
+	}
+}
+
+func TestIntentAdmissionExpiredAndFutureValidityRejected(t *testing.T) {
+	_, _, a := intentFixture(t)
+	IntentControlMu.Lock()
+	defer IntentControlMu.Unlock()
+	a.ValidUntil = a.ValidFrom - 1
+	if _, err := IntentRegisterAdmissionLocked(a, "absent"); err == nil {
+		t.Fatal("expired admission accepted")
+	}
+	a.ValidUntil = a.ValidFrom + 60
+	a.ValidFrom = a.ValidUntil - 1
+	if _, err := IntentRegisterAdmissionLocked(a, "absent"); err == nil {
+		t.Fatal("future admission accepted")
+	}
+}
