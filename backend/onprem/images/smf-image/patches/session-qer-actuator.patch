+func TestIntentAdmissionReleaseOwnerCASAndReadback(t *testing.T) {
+	dir := t.TempDir()
+	if err := os.Chmod(dir, 0700); err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("SMF_SESSION_QER_STATE_DIR", dir)
+	t.Setenv("SMF_SESSION_QER_NETWORK_SCOPE", "city")
+	now := float64(time.Now().UnixNano()) / 1e9
+	a := smf_context.IntentAdmission{Scope: "city", SUPI: "imsi-001010000000099", SessionID: 1, Nonce: "release-test", Owner: "intent", Operation: "operation", TargetUPF: "upf-native", ValidFrom: now - 1, ValidUntil: now + 60}
+	smf_context.IntentControlMu.Lock()
+	a, err := smf_context.IntentRegisterAdmissionLocked(a, "absent")
+	smf_context.IntentControlMu.Unlock()
+	if err != nil {
+		t.Fatal(err)
+	}
+	version := smf_context.IntentAdmissionVersion(a)
+	p := &Processor{}
+	release := func(owner, expected string) *httptest.ResponseRecorder {
+		body, _ := json.Marshal(map[string]string{"ownerId": owner, "operationId": "operation", "expectedVersion": expected})
+		out := httptest.NewRecorder()
+		c, _ := gin.CreateTestContext(out)
+		c.Request = httptest.NewRequest("POST", "/session-admissions/release-test/release", bytes.NewReader(body))
+		c.Params = gin.Params{{Key: "nonce", Value: a.Nonce}}
+		p.HandleIntentAdmissionRelease(c)
+		return out
+	}
+	if out := release("foreign", version); out.Code != 409 {
+		t.Fatal("foreign owner cancelled admission", out.Code)
+	}
+	if out := release(a.Owner, "stale"); out.Code != 409 {
+		t.Fatal("stale CAS cancelled admission", out.Code)
+	}
+	out := release(a.Owner, version)
+	if out.Code != 200 {
+		t.Fatal(out.Code, out.Body.String())
+	}
+	var response map[string]interface{}
+	if err = json.Unmarshal(out.Body.Bytes(), &response); err != nil {
+		t.Fatal(err)
+	}
+	if response["status"] != "cancelled" || response["source"] != "native-smf-session-admission/v1" || response["installation_version"] != a.InstallationVersion || response["version"] == version {
+		t.Fatal("invalid immutable installation/CAS proof", response)
+	}
+	if out = release(a.Owner, version); out.Code != 409 {
+		t.Fatal("stale release replay accepted")
+	}
+	c, _ := gin.CreateTestContext(httptest.NewRecorder())
+	c.Params = gin.Params{{Key: "nonce", Value: a.Nonce}}
+	p.HandleIntentAdmissionRead(c)
+	if c.Writer.Status() != 200 {
+		t.Fatal("cancelled record no longer readable")
+	}
+}
