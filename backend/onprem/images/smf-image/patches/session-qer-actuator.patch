+// Missing records are ordinary absence; every store/lineage failure remains fail closed.
+func TestIntentAdmissionReadOnlyExactRecordAbsenceReturns404(t *testing.T) {
+	for _, damage := range []string{"absent", "root-missing", "selection-missing", "selection-permissions", "corrupt", "record-permissions", "boot-changed"} {
+		t.Run(damage, func(t *testing.T) {
+			root := t.TempDir()
+			if err := os.Chmod(root, 0700); err != nil {
+				t.Fatal(err)
+			}
+			dir := filepath.Join(root, "selection")
+			if err := os.Mkdir(dir, 0700); err != nil {
+				t.Fatal(err)
+			}
+			t.Setenv("SMF_SESSION_QER_STATE_DIR", root)
+			nonce := "fresh-native-test"
+			file := filepath.Join(dir, "admission-"+smf_context.IntentDigest(nonce)+".json")
+			want := http.StatusConflict
+			switch damage {
+			case "absent":
+				want = http.StatusNotFound
+			case "root-missing":
+				t.Setenv("SMF_SESSION_QER_STATE_DIR", filepath.Join(root, "missing"))
+			case "selection-missing":
+				if err := os.Remove(dir); err != nil {
+					t.Fatal(err)
+				}
+			case "selection-permissions":
+				if err := os.Chmod(dir, 0000); err != nil {
+					t.Fatal(err)
+				}
+				t.Cleanup(func() { _ = os.Chmod(dir, 0700) })
+			case "corrupt":
+				if err := os.WriteFile(file, []byte("{"), 0600); err != nil {
+					t.Fatal(err)
+				}
+			case "record-permissions":
+				if err := os.WriteFile(file, []byte("{}"), 0000); err != nil {
+					t.Fatal(err)
+				}
+			case "boot-changed":
+				a := smf_context.IntentAdmission{Nonce: nonce, BootEpoch: "previous-smf-boot", Status: "registered"}
+				if err := smf_context.IntentSaveAdmissionLocked(a); err != nil {
+					t.Fatal(err)
+				}
+			}
+			before, _ := os.ReadDir(root)
+			out := httptest.NewRecorder()
+			c, _ := gin.CreateTestContext(out)
+			c.Params = gin.Params{{Key: "nonce", Value: nonce}}
+			(&Processor{}).HandleIntentAdmissionRead(c)
+			if out.Code != want {
+				t.Fatalf("%s: HTTP %d, want %d; %s", damage, out.Code, want, out.Body.String())
+			}
+			after, _ := os.ReadDir(root)
+			if len(before) != len(after) {
+				t.Fatal("read initialized a missing store")
+			}
+			if damage == "absent" {
+				if _, err := os.Lstat(file); !os.IsNotExist(err) {
+					t.Fatal("absence read created an admission")
+				}
+			}
+		})
+	}
+}
