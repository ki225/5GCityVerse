+			t.Fatalf("invalid legacy proof: %+v", proof)
+		}
+		if i > 0 && proof.BootEpoch != epoch {
+			t.Fatal("boot epoch changed between atomic reads")
+		}
+		epoch = proof.BootEpoch
+	}
