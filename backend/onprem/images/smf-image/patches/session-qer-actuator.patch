+func TestNativeFullUPFCensusIncludesEmptyUPFAndRejectsOrphans(t *testing.T) {
+	old := smf_context.GetSelf().UserPlaneInformation
+	defer func() { smf_context.GetSelf().UserPlaneInformation = old }()
+	id := pfcpType.NodeID{NodeIdType: pfcpType.NodeIdTypeIpv4Address, IP: net.ParseIP("198.18.0.3").To4()}
+	node := &smf_context.UPNode{Name: "native", NodeID: id, UPF: smf_context.NewUPF(&id, nil)}
+	smf_context.GetSelf().UserPlaneInformation = &smf_context.UserPlaneInformation{UPFs: map[string]*smf_context.UPNode{"native": node}}
+	dump := map[string]interface{}{"schemaVersion": "cityverse.upf/v1", "source": "gtp5g-netlink", "available": true, "upf": "native", "epoch": "real-epoch", "observedAt": time.Now().UTC().Format(time.RFC3339Nano), "errors": []interface{}{}, "residuals": []interface{}{}, "sessions": []interface{}{}, "qers": []interface{}{}, "pdrs": []interface{}{}}
+	requests := 0
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { requests++; json.NewEncoder(w).Encode(dump) }))
+	defer server.Close()
+	origins := map[string]string{"198.18.0.3": server.URL}
+	reader := requestNativeUPFReader()
+	if _, err := reader(server.URL); err != nil {
+		t.Fatal(err)
+	}
+	rows, err := verifyNativeFullUPFCensus(origins, reader, map[string]map[string]bool{})
+	if err != nil || len(rows) != 1 || rows[0]["upf_epoch"] != "real-epoch" || requests != 1 {
+		t.Fatal("zero-session native UPF not independently accounted", rows, err, requests)
+	}
+	dump["sessions"] = []interface{}{map[string]interface{}{"pfcpSeid": 101, "upf": "native", "evidence": "kernel-installed-pdr-far"}}
+	if _, err = verifyNativeFullUPFCensus(origins, requestNativeUPFReader(), map[string]map[string]bool{}); err == nil {
+		t.Fatal("other-SMF/orphan kernel session accepted")
+	}
+	dump["sessions"] = []interface{}{}
+	if _, err = verifyNativeFullUPFCensus(origins, requestNativeUPFReader(), map[string]map[string]bool{"198.18.0.3": {"101": true}}); err == nil {
+		t.Fatal("missing kernel session accepted")
+	}
+	dump["qers"] = []interface{}{map[string]interface{}{"pfcpSeid": 202}}
+	if _, err = verifyNativeFullUPFCensus(origins, requestNativeUPFReader(), map[string]map[string]bool{}); err == nil {
+		t.Fatal("orphan kernel QER accepted")
+	}
+	dump["qers"] = []interface{}{}
+	dump["pdrs"] = []interface{}{map[string]interface{}{"seid": 303}}
+	if _, err = verifyNativeFullUPFCensus(origins, requestNativeUPFReader(), map[string]map[string]bool{}); err == nil {
+		t.Fatal("orphan kernel PDR accepted")
+	}
+}
