+func TestNativeActiveInventoryRejectsConcurrentPoolOrStateChurn(t *testing.T) {
+	for _, mode := range []string{"add", "state", "remove"} {
+		t.Run(mode, func(t *testing.T) {
+			dir := t.TempDir()
+			if err := os.Chmod(dir, 0700); err != nil {
+				t.Fatal(err)
+			}
+			oldTEID := smf_context.TeidGenerator
+			smf_context.TeidGenerator = idgenerator.NewGenerator(1, 1000)
+			t.Cleanup(func() { smf_context.TeidGenerator = oldTEID })
+			create := func(id int32) *smf_context.SMContext {
+				sm := smf_context.NewSMContext("imsi-001010000000097", id)
+				sm.SmfPduSessionSmContextCreateData = &models.SmfPduSessionSmContextCreateData{Supi: "imsi-001010000000097"}
+				t.Cleanup(func() { smf_context.RemoveSMContext(sm.Ref) })
+				return sm
+			}
+			first, other := create(1), create(2)
+			first.SetState(smf_context.Active)
+			entered, changed := make(chan struct{}), make(chan struct{})
+			go func() {
+				<-entered
+				switch mode {
+				case "add":
+					create(3)
+				case "state":
+					other.SMLock.Lock()
+					other.SetState(smf_context.Active)
+					other.SMLock.Unlock()
+				case "remove":
+					smf_context.RemoveSMContext(other.Ref)
+				}
+				close(changed)
+			}()
+			once := sync.Once{}
+			engine := &SessionQerEngine{Scope: "city", StateDir: dir, Lookup: smf_context.GetSMContextByRef}
+			engine.Read = func(sm *smf_context.SMContext) (SessionQerView, error) {
+				once.Do(func() { close(entered); <-changed })
+				return SessionQerView{SessionQerIdentity: SessionQerIdentity{Scope: "city", SUPI: sm.Supi, SessionID: sm.PDUSessionID, Ref: sm.Ref, Epoch: sm.Ref, Key: canonicalSessionKey("city", sm.Supi, sm.PDUSessionID, sm.Ref)}, ObservedAt: intentNow()}, nil
+			}
+			out := httptest.NewRecorder()
+			c, _ := gin.CreateTestContext(out)
+			c.Request = httptest.NewRequest("GET", "/session-active-inventory", nil)
+			engine.HandleActiveInventory(c)
+			if out.Code != 409 {
+				t.Fatal("concurrent census incorrectly complete", out.Code, out.Body.String())
+			}
+		})
+	}
+}
