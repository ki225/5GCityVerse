+	}
+	line := append(append([]byte("CITYVERSE_PCF_BOOT_EMPTY "), bootJSON...), '\n')
+	if written, err := os.Stdout.Write(line); err != nil {
+		return nil, err
+	} else if written != len(line) {
+		return nil, io.ErrShortWrite
+	}
 
 	// consumer
 	consumer, err := consumer.NewConsumer(pcf)
