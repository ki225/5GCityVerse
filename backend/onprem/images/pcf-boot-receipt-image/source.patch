 	pcf.ctx, pcf.cancel = context.WithCancel(ctx)
 	pcf_context.Init()
 	pcf.pcfCtx = pcf_context.GetSelf()
+	// Capture and log the new process's empty-policy state before any SBI
+	// listener, NRF registration, or policy handler can run. This says nothing
+	// about the previous PCF process or downstream SMF/UPF state.
+	bootReceipt, err := pcf_context.CaptureBootReceipt(os.Getenv("CITYVERSE_PCF_POD_UID"))
