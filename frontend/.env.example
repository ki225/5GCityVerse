# All commands use the same production onprem application.
# Empty API/WS overrides use the production server's same-origin proxy.
VITE_API_URL=
VITE_WS_URL=
# The browser opens directly. Do not put secrets or AI keys in VITE_*.
# Server-only backend origin, never exposed as a browser credential.
CITYVERSE_BACKEND_URL=http://127.0.0.1:8000
FRONTEND_HOST=127.0.0.1
PORT=5173
