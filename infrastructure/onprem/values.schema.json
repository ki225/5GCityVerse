{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["free5gc", "city", "networks", "images"],
  "properties": {
    "city": {
      "type": "object",
      "required": ["sites", "placement", "gnbs", "slices", "core"],
      "properties": {
        "transportDelay": {
          "type": "object",
          "required": ["enabled", "fibreUsPerKm", "routeStretch", "processingUs"],
          "properties": {
            "enabled": {"type": "boolean"},
            "fibreUsPerKm": {"type": "number", "minimum": 0, "maximum": 10},
            "routeStretch": {"type": "number", "minimum": 1, "maximum": 3},
            "processingUs": {
              "type": "object", "required": ["edge", "distributed", "central"],
              "additionalProperties": false,
              "properties": {
                "edge": {"type": "integer", "minimum": 0, "maximum": 50000},
                "distributed": {"type": "integer", "minimum": 0, "maximum": 50000},
                "central": {"type": "integer", "minimum": 0, "maximum": 50000}
              }
            }
          }
        },
        "placement": {
          "type": "object",
          "required": ["mode"],
          "properties": {"mode": {"enum": ["physical", "colocated"]}}
        },
        "gnbs": {
          "type": "array", "minItems": 7, "maxItems": 7,
          "items": {
            "type": "object",
            "required": ["id", "workload", "slice", "networkIndex", "n3Host", "position"],
            "properties": {
              "id": {"type": "string", "pattern": "^gnb-0-[0-6]$"},
              "workload": {"type": "string", "pattern": "^gnb-[a-z0-9-]+$"},
              "slice": {"enum": ["embb", "urllc", "mmtc", "v2x"]},
              "networkIndex": {"type": "integer", "minimum": 1, "maximum": 200},
              "n3Host": {"type": "integer", "minimum": 31, "maximum": 230},
              "position": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": 0, "maximum": 24}},
              "replicas": {"const": 1}
            }
          }
        },
        "slices": {
          "type": "object",
          "required": ["embb", "urllc", "mmtc", "v2x"],
          "minProperties": 4, "maxProperties": 4,
          "additionalProperties": {
            "type": "object",
            "required": ["site", "sst", "sd", "uePool", "n3Subnet", "n4Address", "n6Subnet", "resources"],
            "properties": {"sd": {"type": "string", "pattern": "^[0-9a-f]{6}$"}, "replicas": {"const": 1}}
          }
        }
      }
    }
  }
}
